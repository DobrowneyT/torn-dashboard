flowchart LR
 _Prelude_(["Deceive the rapper and sell him a large quantity of PCP disguised as cocaine."])
 _A0_(["The crew arrives at Lil Drizzle&#39;s lavish mansion in the hills."])
 _A0_Cont_(["Entering the property, they are welcomed by two armed guards and Juliet, Driz&#39;s manager."])
 _A1_(["Juliet thanks the team for coming, but questions why they brought extra muscle."])
 _A1_Cont_(["A guard asks Muscle #1 and Muscle #2 to relinquish their weapons."])
 _A1_Cont2_(["Muscle #1 insists they&#39;re unarmed, inviting the guards to frisk them both."])
 _A1_C1_{"Using sleight of hand, Muscle #1 and Muscle #2 hide their weapons."}
 _A1_C1F_["The guard feels something hidden in Muscle #1&#39;s pants and tries to reach inside."]
 _A1_C2_{"Muscle #1 grabs the guard by the collar and dares him to try that again."}
 _A1_C2F_["The guard shoves Muscle #1 away and licks his lips before blowing him a kiss."]
 _A1_C3_{"Muscle #2 pulls a gun on the guard, making it clear they&#39;re not to be messed with."}
 _A1_C3P_["Muscle #2&#39;s threat earns an apology from Juliet, who tells the guard to back off."]
 _A2_(["Juliet demands Muscle #1 and Muscle #2 wait in the foyer."])
 _A2_1_(["Hustler and Imitator are led through to meet Lil Drizzle in his office."])
 _A2_1_Cont_(["Getting straight down to business, Drizzle asks to see the merchandise."])
 _A2_2_(["Imitator opens his case, revealing a collection of vials filled with white powder."])
 _A2_3_(["Drizzle is impressed with the display but he wants to sample the product immediately."])
 _A2_4_(["Juliet reminds Drizzle that he has a video to shoot later that day."])
 _A2_C1_{"Hustler suggests using a testing kit instead to ensure Driz remains sober."}
 _A2_C1P_["Lil Drizzle backs down and asks Juliet to analyze the sample with a reagent test."]
 _A3_(["The lidocaine in the powder returns a false positive, faking the presence of cocaine."])
 _A3_1_(["Almost convinced, Driz asks his manager to snort a line as confirmation of its quality."])
 _A3_C1_{"Imitator asserts that applying coke to your gums is the best way to test its purity."}
 _A3_C1F_["Drizzle dismisses this suggestion and demands that Juliet snort a whole line."]
 _A3_2_(["Hustler glances at Imitator, desperately looking for a solution."])
 _A3_C2_{"Hustler says it&#39;ll work quicker if taken orally, reminding Driz he&#39;s a busy man."}
 _A3_C2P_["Drizzle relents and tells Imitator to hurry up before he gets pissed off."]
 _A3_4_(["Imitator prepares a dose of the fake cocaine for Juliet."])
 _A4_(["Juliet applies the fake cocaine to her gums, signaling that the product is good."])
 _A4_1_(["Drizzle orders one of his guards to fetch the money from the office safe."])
 _A4_1_Cont_(["The rapper tries to bargain for a lower price, offering more business in the future."])
 _A4_C1_{"Hustler says his boss won&#39;t let him negotiate and threatens to pull out."}
 _A4_C1P_["Hustler&#39;s sales tactics work and Drizzle agrees to pay full price for the drugs."]
 _A5_(["Hustler takes the cash and thanks Lil Drizzle for his business."])
 _A5_1_(["The rapper asks the team for help with another issue, offering them an extra payment."])
 _A5_2_(["Hustler insists they first hand over the cash to avoid trouble with the boss."])
 _A5_3_(["Drizzle allows Hustler to give the money to Muscle #1."])
 _A5_4_(["Muscle #1 and Muscle #2 move the cash to the car and return to the lobby."])
 _A5_5_(["Juliet excuses herself to take five–the PCP is starting to affect her."])
 _A5_6_(["Lil Drizzle leads Hustler and Imitator to his in-house laboratory."])
 _A5_7_(["He asks them to cook up a custom blend of lean that will make his guests more promiscuous."])
 _A5_C1_{"Hustler refuses, claiming their boss will have them killed."}
 _A5_C1F_["Drizzle insists that what their boss doesn&#39;t know won&#39;t hurt them, but he will."]
 _A5_8_(["Lil Drizzle lifts his shirt to flash a pistol secreted in his waistband."])
 _A5_C2_{"Imitator insists that he doesn&#39;t have the time or tools to meet his request."}
 _A5_C2P_["Drizzle buys Imitator&#39;s explanation, realizing it was a long shot."]
 _A6_(["Drizzle asks Imitator if he can recommend an existing product instead."])
 _A6_1_(["Imitator suggests he should mix cough syrup with Love Juice."])
 _A6_1_Cont_(["Drizzle seems unconvinced by this simplistic approach and dismisses the idea."])
 _A6_C1_{"Imitator explains how the products combine to induce a state of frenzied arousal."}
 _A6_C1F_["Imitator stumbles over his words and fails to sell the idea to the rapper."]
 _A6_2_(["Sensing nerves, Drizzle asks Hustler if Imitator is a real chemist."])
 _A6_C2_{"Hustler steps in, offering Driz an exclusive product that&#39;s stashed in the car."}
 _A6_C2P_["The rapper calms down and orders them to fetch the product."]
 _A6_3_(["Hustler and Imitator head to the car, followed by Driz and a guard."])
 _B7_(["The rapper notices Juliet mumbling to herself and walking in circles—she looks insane."])
 _B7_1_(["Drizzle realizes he&#39;s been sold some cut gear and orders his guards to open fire."])
 _B7_C1_{"Muscle #1 and Muscle #2 provide covering fire to allow the crew to escape."}
 _B7_C1F_["Muscle #1 fails to protect Hustler, the pair riddled with bullets."]
 _B7_3_(["Muscle #2 holds the guards off as the team retreats to its vehicle."])
 _B7S2_(["Peppered by gunfire, the team somehow manages to escape without further injury."])
 _A5_C1P_["The rapper backs down, explaining that he doesn&#39;t need to get into any more beefs."]
 _A6_C2F_["Growing impatient, Drizzle tells one of his guards to teach these fools a lesson."]
 _A6_4_(["Hustler hurls a glass beaker at the guard&#39;s face, allowing them to escape."])
 _A6_C3_{"Seeing the team is in danger, Muscle #1 and Muscle #2 give covering fire."}
 _A6_C3P_["Muscle #1 and Muscle #2 keep the guards at bay, helping the others escape."]
 _B8_(["As the team retreats, a lucky shot clips Muscle #2&#39;s neck, wounding him badly."])
 _B8S_(["Their lives in danger, the team is forced to flee, leaving Muscle #2 behind."])
 _A4_C1F_["Hustler&#39;s sales tactics falter and Drizzle says he&#39;ll find another dealer."]
 _A4_2_(["Hustler closes the case and says they&#39;ll sell the drugs to Yung Tendies instead."])
 _A4_C2_{"The crew plays on Drizzle’s beef with Tendies to make him jealous and push for a deal."}
 _A4_C2P_["Drizzle falls for the manipulation and agrees to buy the merchandise."]
 _B7_C1P_["While shielding the team from gunfire, Muscle #1 takes a bullet to the shoulder."]
 _B7_2_(["Muscle #2 helps Muscle #1 escape as the rest of the crew sprints past."])
 _B7S1_(["Under a barrage of gunfire, the team narrowly escapes with the cash and their lives."])
 _A3_C2F_["Drizzle gets angry at Hustler trying to order him around."]
 _A3_3_(["Hustler suggests that he should calm down—a big mistake."])
 _A4_5_(["Drizzle says he wants a five-finger discount and pulls out a gun, as does his guard."])
 _A4_C3_{"Hustler disarms the rapper and takes his weapon, restraining him in a chokehold."}
 _A4_C3F_["Unfazed, Drizzle tells his guard to shoot Imitator, wounding his right buttock."]
 _A4_7_(["Hustler punches Drizzle and checks on Imitator, his gun still raised."])
 _A4_8_(["Defeated, Driz signals his guard to let them go, his pride shattered."])
 _A4F_(["The team leaves with nothing to show for their effort but a cap in Imitator&#39;s ass."])
 _A6_C3F_["As more guards arrive, Muscle #1 and Muscle #2 are hit in quick succession."]
 _A6F_(["Hustler and Imitator are gunned down too, leaving the mission in ruins."])
 _A1_C2P_["Muscle #1’s menacing stance compels Juliet to step in and make the guard back down."]
 _A2_C1F_["Drizzle doesn&#39;t like being told what to do by Hustler and grabs a drug sample."]
 _A2_C2_{"To dissuade him, Imitator jokes it&#39;ll be easier to negotiate if Drizzle is high."}
 _A2_C2P_["Drizzle appreciates Imitator&#39;s candor and asks Juliet to fetch a test."]
 _A3_C1P_["Drizzle agrees, gesturing for Imitator to prepare a dose."]
 _A6_C1P_["Imitator&#39;s pitch on the mixture&#39;s aphrodisiac effect is surprisingly persuasive."]
 _A7_(["Delighted, Driz tells one of his guards to go and buy a case of Love Juice, pronto."])
 _A7_1_(["As the team leaves, the rapper notices Juliet convulsing in a puddle of her own urine."])
 _A7_2_(["Drizzle is furious and demands to know what the drugs have been cut with."])
 _A7_C1_{"Imitator explains their product is likely interacting with another medication."}
 _A7_C1P_["To strengthen the ruse, Imitator pretends to find some pills in Juliet&#39;s pocket."]
 _A8_(["Drizzle fires his manager and asks the guards to escort the team outside."])
 _A8S1_(["The team escapes with the cash, having successfully ripped off their famous client."])
 _A1_C1P_["The guard fails to find the hidden weapons on Muscle #1 and Muscle #2."]
 _A5_C2F_["Drizzle is insulted and starts pistol-whipping Imitator with the help of a guard."]
 _A5_9_(["Fearful of reprisals, Drizzle orders his guards to brutalize the rest of the team."])
 _A5F_(["The guards lay into the team hard, bringing the mission to an abrupt end."])
 _A7_C1F_["Imitator&#39;s tone is uncertain and Drizzle accuses him of being a fraud."]
 _A8_1_(["Drizzle draws a gun and aims it at Imitator, demanding his money back."])
 _A8_2_(["Hustler tells Drizzle to calm down. The rapper&#39;s guards draw their weapons."])
 _A8_3_(["Muscle #1 and Muscle #2 take defensive positions at the top of the stairs."])
 _A8_4_(["Seeing the bodyguards rush in, Drizzle gets a shot off, wounding Muscle #1."])
 _A8_5_(["Muscle #1 fires back, downing the rapper, before staggering down the stairs."])
 _A8_6_(["As the team takes cover behind the piano, Muscle #2 eliminates the two guards."])
 _A8_7_(["Muscle #2 helps Muscle #1 outside with the others following behind."])
 _A8S2_(["The team escapes with the cash, leaving behind a case of PCP and a pile of dead bodies."])
 _A4_C2F_["The rapper is overcome with fury and feels disrespected at the mere mention of his rival."]
 _A4_4_(["Realizing he&#39;s gone too far, Hustler apologizes, offering Lil Driz a deal."])
 _A4_C3P_["Feeling the squeeze, Driz tells his guard to lower his gun and let the team leave."]
 _A4_6_(["With the rapper held hostage, Hustler exits as Imitator grabs the cash."])
 _A4S_(["As they reach the car, Hustler shoves Driz aside before the team zooms off."])
 _A1_C3F_["In a display of bravado, the guard dares Muscle #2 to pull the trigger."]
 _A1_1_(["Lil Drizzle strides in to take charge of the situation."])
 _A1_2_(["After Juliet reveals what&#39;s transpired, the rapper cancels the deal."])
 _A1_3_(["Hustler and Imitator express regret, blaming a misunderstanding."])
 _A1F_(["The team&#39;s apologies are met with silence and Drizzle&#39;s guards force them to leave."])
 _A2_C2F_["Drizzle ignores Imitator&#39;s warning and shoves a mound of fake coke up his nose."]
 _A2_5_(["Drizzle&#39;s face screws up—he knows something is very, very wrong."])
 _B1_(["Hustler realizes Driz is about to go nuts, having just taken an overdose of PCP."])
 _B1_1_(["Hustler buzzes the guard team&#39;s cell phones to alert them to the situation."])
 _B1_2_(["Pushing past Driz&#39;s guards, Muscle #1 and Muscle #2 burst in, guns drawn."])
 _B1_3_(["Muscle #1 takes aim at Drizzle as he stands there in a drug-induced stupor."])
 _B1_C1_{"His bodyguard draws a gun, forcing Muscle #1 to duck behind a piano."}
 _B1_C1P_["Dodging gunfire, Muscle #1 downs one guard and manages to escape the mansion."]
 _B1F3_(["Muscle #1 dives into the car and the team races off without payment."])
 _B1_C1F_["Muscle #1 takes a shot to the shin, his tibia shattering as he collapses."]
 _B1_C2_{"As Drizzle convulses on the floor, his guards give chase. Muscle #2 returns fire."}
 _B1_C2F_["Hustler lingers in the open and Muscle #2 can&#39;t stop him being hit."]
 _B1_5_(["When Imitator is also gunned down, Muscle #2 retreats to the vehicle."])
 _B1F1_(["Muscle #2 slams the car into reverse and flees, leaving the crew to a grim fate."])
 _B1_C2P_["The guards descend the stairs, but Muscle #2 picks them off from behind the car."]
 _B1F2_(["The team escapes in its vehicle, with one seat empty and no reward to show."])

