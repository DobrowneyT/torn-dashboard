flowchart LR
 _Prelude_(["Slip into the maintenance facility and snatch a working HMMWV."])
 _A1_(["The team gathers by the fenced perimeter of the repair center."])
 _A1_1_(["As they skulk through the darkness, a CCTV camera sweeps the area up ahead."])
 _A1_2_(["Engineer creeps beneath the camera and kneels to give Techie a boost."])
 _A1_C1_{"Held aloft, Techie takes out the spray can and tries to obscure the camera&#39;s view."}
 _A1_C1F_["Engineer wobbles and causes Techie to miss the camera."]
 _A1_C2_{"Techie scolds Engineer and tells him to hold steady."}
 _A1_C2P_["This time, Techie nails the camera with the paint, blocking its view."]
 _A2_(["Car Thief uses his bolt cutters to cut a hole in the sturdy chain-link fence."])
 _A2_1_(["Sneaking through the gap, the crew ducks behind a parked car to avoid the patrol."])
 _A2_C1_{"Observing the guard, Techie signals the team to move on his command."}
 _A2_C1F_["Techie moves too late, drawing the guard’s attention."]
 _A2_C2_{"As the guard bears down, Techie notices Car Thief&#39;s leg is sticking out."}
 _A2_C2P_["Techie drags Car Thief out of sight just in time."]
 _A2_5_(["The guard continues on his way, allowing the team to enter the motor pool."])
 _A3_(["Car Thief climbs into the Humvee as the others keep watch."])
 _A3_Cont_(["Car Thief pushes the ignition switch, but nothing happens—the Humvee is dead."])
 _A3_1_(["Engineer directs Car Thief to check under the seat for the power unit."])
 _A3_2_(["Car Thief slides the seat back and finds the battery compartment empty."])
 _A3_2_Cont1_(["The crew scours the facility for a compatible battery."])
 _A3_C1_{"With a battery secured, Techie returns to the Humvee to install it."}
 _A3_C1F_["Techie fits the battery but the Humvee remains dead."]
 _A3_C2_{"Engineer examines the battery housing, double-checking each connection."}
 _A3_C2P_["The Humvee&#39;s dashboard lights up as Engineer reconnects the battery."]
 _A4_(["A quick look at the fuel gauge tells Car Thief the gas tank is empty."])
 _A4_Cont_(["Car Thief jumps out and checks the nearby fuel pump, finding it locked."])
 _A4_C1_{"Bolt cutters in hand, Car Thief tries to remove the padlock."}
 _A4_C1F_["Car Thief squeezes with all his might, but the lock refuses to break."]
 _B4_C1_{"Engineer grabs the bolt cutters and tries to cut through the shank of the lock."}
 _B4_C1P_["The cutters shear through the metal, allowing Engineer to refuel the vehicle."]
 _B4_2_(["The guard overhears the crew&#39;s activities and comes to investigate."])
 _B4_3_(["Engineer reaches for the chloroform in his pocket."])
 _B4_4_(["The jar slips from his fuel-covered hands and shatters on the floor."])
 _B5_C1_{"Silently, Car Thief picks up the bolt cutters and circles behind to ambush the guard."}
 _B5_C1P_["Car Thief cracks the guard&#39;s skull open with a heavy blow."]
 _B5_1_(["A voice suddenly blares out from the guard&#39;s radio to ask what&#39;s going on."])
 _B5_2_(["There&#39;s a second guard who must be subdued, but Engineer is out of chloroform."])
 _B5_3_(["Techie heads over to deal with her while the others prepare the vehicle."])
 _B5_4_(["With Techie stalking through the shadows, the guard leaves her post."])
 _B8_C1_{"Techie tackles the guard into the cabin and tries to restrain her."}
 _B8_C1P_["The guard is knocked out after Techie smashes her face through a table."]
 _B9_(["After opening the gate, Techie returns to the Humvee."])
 _B9S_(["The team exits the facility in a military-grade assault vehicle, ready to wreak havoc."])
 _A3_C2F_["Despite Engineer&#39;s efforts, the Humvee&#39;s electrics remain unresponsive."]
 _A3_C3_{"Car Thief goes to fetch a second battery, presuming the first to be a dud."}
 _A3_C3P_["Car Thief installs the fresh battery and the Humvee&#39;s interiors light up."]
 _A3_6_(["Climbing into the driver&#39;s seat, Car Thief gets ready to start the vehicle."])
 _A3_7_(["Car Thief notices that the needle on the fuel gaze is pinned on zero."])
 _A3_8_(["Car Thief sends Engineer to check the nearby fuel pump, but it’s locked tight."])
 _B8_C1F_["The guard swings a metal ammo box at Techie, breaking her jaw."]
 _B8_(["Hearing the brawl, Car Thief and Engineer rush over to help."])
 _B8_1_(["The guard pulls out her gun and tells the crew to back off."])
 _B8_C2_{"Car Thief and Engineer close in from both sides, approaching in a pincer movement."}
 _B8_C2P_["Engineer is shot as Car Thief smashes the guard&#39;s head with the bolt cutters."]
 _B8_2_(["Car Thief opens the gate and rushes back to fetch the Humvee."])
 _B8_3_(["Car Thief parks by the guard post and helps his injured teammates into the vehicle."])
 _B8S_(["Engine roaring, Car Thief guns the Humvee through the gate before backup arrives."])
 _A2_C2F_["Techie moves too late, drawing the guard’s attention."]
 _A2_2_(["The guard&#39;s investigations intensify as he bears down upon the team."])
 _A2_C3_{"Engineer tosses a rock to distract the guard."}
 _A2_C3P_["The guard takes the bait, rounding the corner in search of the noise."]
 _A2_3_(["Seizing the moment, the crew hotfoots it into the motor pool."])
 _A4_C1P_["Car Thief shears the lock clean off, allowing him to refuel the Humvee."]
 _A5_(["The guard overhears the crew&#39;s activities and comes to investigate."])
 _A5_1_(["As he enroaches on their position, Engineer pulls out his chloroform."])
 _A5_C1_{"Engineer tries to creep up behind the guard without him noticing."}
 _A5_C1F_["The guard turns and draws his gun, ordering Engineer to drop his chloroform."]
 _B8_C2F_["The guard reacts fast, dropping both crewmates before they get anywhere near her."]
 _B8F_(["With the whole team bleeding in the dirt, the mission ends in defeat."])
 _A1_C2F_["Engineer holds steady but a gust of wind blows paint into Techie&#39;s face."]
 _A1_C3_{"Car Thief becomes angry and takes Techie&#39;s place."}
 _A1_C3P_["Lifted up by Engineer, Car Thief hits the camera with a blast of paint."]
 _A3_C1P_["The battery clicks in, and the dashboard lights flicker to life."]
 _B5_C1F_["The guard notices Car Thief and steps back to cover both intruders."]
 _B5_C2_{"Techie charges at the guard and tries to snatch his firearm."}
 _B5_C2P_["The guard is tackled to the floor and relieved of his weapon by Techie."]
 _B5_(["As the guard shouts into his radio, Engineer stomps on his head to silence him."])
 _B6_(["The crew hears a woman&#39;s voice shouting through the guard&#39;s radio."])
 _B6_1_(["Realizing a second guard is on her way, the team take up defensive positions."])
 _B6_2_(["The security guard enters the motor pool with her gun drawn, finger on the trigger."])
 _B6_C1_{"Engineer emerges to distract her as Car Thief approaches from behind."}
 _B6_C1P_["Car Thief lobs the bolt cutters at the guard, knocking her out cold."]
 _B7_(["With no more guards present, Techie heads to the guard post to unlock the gate."])
 _B7_1_(["As Techie returns, he notices one of the downed guards is missing."])
 _B7_2_(["The guard leaps out and smashes Techie in the back of the head with a canister."])
 _B7_3_(["As he approaches the Humvee, Car Thief floors the gas and runs the guard over."])
 _B7S_(["A third guard shows up, forcing the crew to abandon Techie to ensure their escape."])
 _A3_C3F_["The fresh battery makes no difference as the Humvee refuses to play ball."]
 _A3_5_(["Invested in the technical issue, the team fails to notice the guard creeping over."])
 _A3F_(["With his weapon drawn, the guard detains the team and calls for backup."])
 _A1_C1P_["Techie covers the lens in thick black paint, rendering the camera useless."]
 _B4_C1F_["Engineer slips and cuts through the fuel line, spilling gas everywhere."]
 _B4_1_(["The guard overhears the noise and catches the team red handed!"])
 _B4F_(["Caught off balance on the oil-slicked ground, the crew is taken down at gunpoint."])
 _A2_C1P_["On Techie&#39;s cue, they slip past the guard and into the motor pool."]
 _A5_C1P_["Pressing chloroform to his face, Engineer subdues the guard."]
 _A6_(["As the team prepares to leave, a crackle from the guard&#39;s radio stops them abruptly."])
 _A6_1_(["The gate guard checks in with her colleague, demanding a status update."])
 _A6_2_(["The second guard must be eliminated, but Engineer is out of chloroform."])
 _A6_3_(["Techie grabs a length of electrical wire and sneaks toward the gatepost."])
 _A6_C1_{"Moving stealthily, Techie bangs on the glass to draw out the guard."}
 _A6_C1F_["The guard sees through the ruse and turns to grapple with Techie."]
 _B5_C2F_["The guard reacts quickly, dropping Techie with a shot to the chest."]
 _B5F_(["Car Thief and Engineer surrender as the guard calls for backup."])
 _B6_C1F_["The guard isn&#39;t fooled and she clocks Car Thief&#39;s attempt to sneak up on her."]
 _B6_C2_{"Her attention drawn elsewhere, Techie tries to get the jump on the guard."}
 _B6_C2P_["Techie ambushes the guard from behind and chokes her out."]
 _A6_C1P_["Techie attacks from behind, wrapping the wire around the guard&#39;s neck to choke her out."]
 _A7_(["With no more security to deal with, Techie opens the main gate."])
 _A7_1_(["Car Thief already has the engine roaring when Techie returns."])
 _A7S_(["Climbing aboard the Humvee, the crew escape the repair base with their shiny new toy."])
 _B6_C2F_["Techie&#39;s movements alert the guard and she opens fire."]
 _B6_3_(["The guard drops Techie and Engineer as Car Thief bolts for the gap in the fence."])
 _B6F_(["Car Thief is the only survivor as the team&#39;s Humvee heist ends in defeat."])
 _A1_C3F_["Car Thief&#39;s face is caught on camera, exposing him to the watching guard!"]
 _A1F_(["The guard raises the alarm, forcing the team to abandon the mission."])
 _A2_C3F_["Engineer&#39;s throw lands short and draws the guard toward them."]
 _A2_4_(["Fearing capture, Engineer makes a break for it, followed by the others."])
 _A2F_(["With the guard on their tail, the team makes a narrow escape through the fencing."])

