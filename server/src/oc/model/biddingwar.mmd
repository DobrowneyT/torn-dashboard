flowchart LR
 _Prelude_(["Raid the underground auction, secure as much loot as you can, and make it out alive."])
 _A1_(["The Humvee is parked by the side of the auction house and the team spills out."])
 _A1_C1_{"Intent on making a dramatic entrance, Bomber #1 attaches a C4 explosive to the wall."}
 _A1_C1P_["The bomb detonates and creates a significant fracture in the side of the building."]
 _A2_(["Driver reverses the Humvee into position, ready to punch through the broken wall."])
 _A2_C1_{"The Humvee crashes into the wall but gets stuck halfway through."}
 _A2_C1P_["Driver maneuvers the vehicle through the rubble and breaks into the auction house"]
 _A3_(["Once the team has moved in, Driver blocks the opening with the vehicle."])
 _A3_1_(["Bomber #1 acts swiftly, grabbing the jewel-encrusted dagger left on the stage."])
 _A3_1_Cont_(["Meanwhile, Robber #2 and Robber #3 use chairs to wedge the main entrance shut."])
 _A3_2_(["The rest of the team searches backstage, locating a display case of Fabergé eggs."])
 _A3_C1_{"Robber #1 attempts to pry open the display case with his jemmy."}
 _A3_C1F_["The lock breaks but gets stuck, blocking access to the valuable items inside."]
 _A3_C2_{"Robber #2 grabs the jemmy and tries to access the case with brute force."}
 _A3_C2F_["The glass case resists Robber #2&#39;s attempts to smash it open."]
 _A3_C3_{"Robber #1 and Robber #2 use their hands to try to rip the whole thing from the wall."}
 _A3_C3P_["After some effort, the display comes loose and falls to the floor."]
 _A3_3_(["Among the shattered glass, Robber #1 picks out intact Fabergé eggs."])
 _A4_(["As the loot is hauled to the Humvee, Driver signals that they&#39;ve got company."])
 _A4_1_(["The crew swiftly gets into position to ambush the security team."])
 _A4_C1_{"As the guards squeeze past the vehicle, Robber #3 realizes she has a clear shot."}
 _A4_C1P_["Robber #3 takes down both guards with unerring precision."]
 _A4_3_(["Half the team presses on with the raid while the others keep watch for more guards."])
 _A4_4_(["Inside the holding room, the crew stumbles upon a treasure trove of valuable items."])
 _A4_R3_(["Bomber #1 wrenches a briefcase open, finding a cache of gleaming gold bars."])
 _A5_(["Hearing a noise from the back of the auction house, Robber #3 goes to investigate."])
 _A5_1_(["Using a small mirror, Robber #3 looks around the corner and spots two armed guards."])
 _A5_2_(["Robber #3 rushes back to alert the crew of the looming threat."])
 _A5_3_(["The crew positions themselves to ambush the approaching security team."])
 _A5_C1_{"Robber #3 observes them covertly using the mirror, preparing to signal the attack."}
 _A5_C1F_["Robber #2 tosses his flash grenade early, allowing the guards to shield their eyes."]
 _A5_4_(["Bomber #2 primes her C4 and passes it to Robber #2 to enact plan B."])
 _A5_C2_{"With the plastic explosive set, Robber #2 lobs it toward the guards."}
 _A5_C2P_["The bomb explodes on time, turning the guards into a mist of blood and bone."]
 _A6_1_(["The team charges forward to engage the remaining guards but Driver is struck down."])
 _A6_2_(["Bomber #2 drags Driver to safety as Robber #3 lays down suppressing fire."])
 _A6_C2_{"Robber #2 moves forward to take out the last remaining guard."}
 _A6_C2F_["The guard spots Robber #2 coming and blasts him in the chest."]
 _A6_5_(["Robber #3 seizes the opportunity and puts several bullets into the guard&#39;s chest."])
 _A6_6_(["Robber #3 and Bomber #2 carry their injured teammates to the Humvee."])
 _A6_7_(["Shorthanded by injuries, the others grab as much of the remaining loot as they can."])
 _A6_8_(["They climb aboard the Hummer and Bomber #2 reverses out of the auction house."])
 _A6S2_(["With bullets pinging off the vehicle, the Humvee shields the crew as they roar to safety."])
 _A1_C1F_["The bomb fails to detonate, leaving Bomber #1 scratching his head."]
 _A1_C2_{"Bomber #1 and Bomber #2 work together to completely rewire the C4."}
 _A1_C2P_["Finally, the bomb explodes, sending a shockwave that cracks the auction house wall."]
 _A4_C1F_["Robber #3 hits one guard but misses the other, forcing him to retreat."]
 _A4_C2_{"Bomber #2 sneaks around the Humvee to surprise the guard."}
 _A4_C2P_["Climbing onto the vehicle, Bomber #2 drops the guard with a headshot."]
 _A4_5_(["Having eliminated the threat, half of the crew keep watch while the others go looting."])
 _A5_C1P_["On Robber #3&#39;s cue, Robber #2 blinds two attackers with a flash grenade."]
 _A6_(["Bomber #1 moves in and drops both guards with quick, lethal shots."])
 _A6_Cont_(["The team presses forward to surround the retreating guards."])
 _A6_C1_{"Robber #3 and Driver flank the enemy from the rear, taking them by surprise."}
 _A6_C1F_["Driver puts down one guard but is accidentally shot by Robber #3!"]
 _A1_C2F_["Tension spreads among the team as the bomb fails to detonate once more."]
 _A1_2_(["Robber #1 pulls a gun on the bombers and tells them he is losing patience."])
 _A1_C3_{"Driver steps over to see if he can help Bomber #1 figure out what&#39;s wrong."}
 _A1_C3P_["After Bomber #1&#39;s mistakes are fixed the bomb detonates, cracking the wall open."]
 _A2_C1F_["Driver struggles to free the vehicle, blocking the team&#39;s entry."]
 _A2_C2_{"Hammering the accelerator, Driver tries to brute force his way through the gap."}
 _A2_C2F_["The engine sputters and stalls, leaving the vehicle firmly wedged in the gap."]
 _A2_C3_{"Driver quickly restarts the engine and backs the vehicle away from the wall."}
 _A2_C3P_["Driver gains momentum and manages to crash through the rubble."]
 _A3_C2P_["Robber #2 smashes the case open, damaging one of the three Fabergé eggs inside."]
 _A6_C1P_["The last remaining guards are executed in cold blood."]
 _A7_(["Fearing further interference, Bomber #2 is told to rig the staircase with explosives."])
 _A7_1_(["The rest of the crew fills the Humvee with their loot and prepares to leave."])
 _A7_2_(["Robber #3 checks their exit route and sees more guards on their way."])
 _A7_C1_{"Bomber #2 also hears footsteps coming from the floor above and readies the bomb."}
 _A7_C1P_["Timing it perfectly, Bomber #2 blows up the staircase as the security team descends."]
 _A8_(["Bomber #2 dashes to the Humvee as Driver starts the engine."])
 _A8_1_(["Driver crushes a guard beneath his wheels as he backs out of the building."])
 _A8S_(["The team escapes the carnage with a stunning haul of valuable loot."])
 _A4_R2_(["Robber #2 busts into a trunk and discovers a trove of priceless rubies."])
 _A7_C1F_["Bomber #2 sets off the explosion late, allowing two guards to make it downstairs."]
 _A8_2_(["One guard recovers and gets a shot off, striking Bomber #2 in the head."])
 _A8_3_(["Driver sees the guards approaching and starts the engine."])
 _A8S2_(["Leaving Bomber #2 behind, the crew makes off with a huge amount of stolen treasure."])
 _A3_C1P_["The glass case pops open, granting access to three Fabergé eggs."]
 _A4_R1_(["Robber #1 pries open a jewel case and steals a handful of flawless diamonds."])
 _A5_C2F_["The bomb fails to explode and the security forces press forward."]
 _A5_5_(["A brief shootout ends with four of the crew bleeding profusely on the ground."])
 _A5F_(["Completely outnumbered, Robber #1 and Bomber #1 surrender to the auction house guards."])
 _A6_C2P_["With the guard focused on Robber #3, Robber #2 sneaks up and blows his brains out."]
 _A6_3_(["Bomber #2 carries Driver to the Humvee as the others collect the loot."])
 _A6_4_(["Some items are left behind as they hurry to make their escape."])
 _A6S_(["The team piles into the Humvee and tears out as security swarm the area."])
 _A2_C2P_["Tires screeching, the Humvee barges through the debris and into the auction house."]
 _A4_C2F_["Bomber #2 is spotted while climbing over the Humvee and is shot in the face."]
 _A4_6_(["Driver takes aim and tries to rescue the situation."])
 _A4_7_(["The guard strikes Driver before she can even get a shot away."])
 _A4_8_(["Wise to the team&#39;s amateur approach, the guard tells the others to give themselves up."])
 _A4_9_(["Robber #3 and Robber #2 walk out, drop their guns, and put their hands in the air."])
 _A4_C3_{"Lurking nearby, Robber #1 has one last chance to nail the guard."}
 _A4_C3P_["As the guard goes to apprehend the crew, Robber #1 blasts the back of his head wide open."]
 _A4_10_(["Robber #1 goes to grab some loot while Robber #2 starts the Humvee."])
 _A4_11_(["The Hummer&#39;s engine drowns out the sound of more guards approaching."])
 _A4_12_(["Bomber #1 is taken hostage as Robber #2 is forced out of the vehicle at gunpoint."])
 _A4_13_(["Robber #1 rushes back to see a tense standoff unfolding."])
 _A4_14_(["Robber #1 threatens to smash the valuable Faberge eggs unless given safe passage."])
 _A4_15_(["When the guards laugh, Robber #1 then offers to swap the treasure for his teammates."])
 _A4_16_(["The offer is refused, so Robber #1 pelts the guard with the egg and is shot."])
 _A4_17_(["Robber #1 lobs the eggs at the guard, taking a bullet in return."])
 _A4_18_(["Thinking fast, Bomber #1 plunges the jeweled dagger into the other guard&#39;s thigh."])
 _A4F2_(["With more security incoming, the crew climbs aboard the Humvee and leaves empty-handed."])
 _A4_C3F_["The guard notices Robber #1 and shoots him in the throat."]
 _A4F_(["With Bomber #1 the only armed member remaining, the crew are forced to surrender."])
 _A3_C3F_["No matter how they pull, the case stays anchored in place."]
 _A3_4_(["With fierce determination, Robber #1 and Robber #2 strike the case relentlessly."])
 _A3_5_(["Amid the racket, Driver&#39;s warning about the incoming guards goes unheard."])
 _A3_6_(["Driver fires at the guards but is taken out within seconds."])
 _A3_7_(["Robber #2 and Robber #3 are surprised by another security team entering from the right."])
 _A3_8_(["Robber #1 and Bomber #2 finally realize something is up, but it&#39;s already too late."])
 _A3F_(["Surrounded by security, the crew has no choice but to give themselves up."])
 _A2_C3F_["Driver stalls again, causing the engine to cut out completely."]
 _A2_2_(["Two squads of armed guards descend on the team to deal with the situation."])
 _A2_3_(["Bomber #2 goes for their weapon but is gunned down in an instant."])
 _A2F_(["Realizing the guards are trained professionals, the team willingly hands themselves over."])
 _A1_C3F_["The bomb remains inert and Robber #1 fully loses his shit."]
 _A1_3_(["After firing shots at the wall, he shoots his gun into the air in a rage."])
 _A1_4_(["Driver spots two security guards approaching from the north."])
 _A1_5_(["Robber #1 turns his gun on the guards, wounding one of them."])
 _A1F_(["The team drives off, making a hasty escape from the scene."])

