flowchart LR
 _Prelude_(["Raid the bank, clear out the vault, and make a clean getaway."])
 _A0_(["The team&#39;s van screeches to a halt outside the bank&#39;s main entrance."])
 _A1_(["The crew leaps out and swarms into the bank before the staff can react."])
 _A1_1_(["Weapons drawn, they order everyone in the bank to drop to the floor."])
 _A1_C1_{"Robber and Muscle #1 aim at the guards when they refuse to comply."}
 _A1_C1F_["The guards stand firm, even as Thief #1 reiterates the crew&#39;s demand."]
 _A1_C2_{"Muscle #2 fires a warning shot toward one of the guards."}
 _A1_C2F_["The shot grazes the guard&#39;s hip, prompting him and his partner to return fire."]
 _A1_C3_{"Muscle #3 holds a hostage at gunpoint, threatening her life to stop the shootout."}
 _A1_C3P_["The guards drop their weapons and lower themselves to the ground."]
 _A2_(["The team corrals the guards and customers, zip-tying their hands behind their backs."])
 _A2_2_(["A sudden sound from the staff area draws the team&#39;s attention."])
 _A2_3_(["Muscle #2 and Thief #1 move silently to investigate the noise."])
 _A2_C1_{"Muscle #2 and Thief #1 focus on the restrooms, looking for more employees."}
 _A2_C1F_["Finding nothing, Muscle #2 and Thief #1 decide to head back to the lobby."]
 _A2_6_(["As they leave the bathroom, a creaking noise stops them in their tracks."])
 _A2_C2_{"Muscle #2 and Thief #1 close the door from the inside, pretending to leave."}
 _A2_C2P_["Believing it&#39;s safe, a shivering old man emerges from the final stall."]
 _A3_(["The old man is zip-tied and taken to the lobby to join the others."])
 _A3_1_(["The team moves on to secure the western wing of the bank."])
 _A3_2_(["As Muscle #3 enters a meeting room, a hidden banker lunges out to attack her."])
 _A3_2_Cont_(["The banker grabs Muscle #3&#39;s weapon and aims it at her head."])
 _A3_C1_{"Muscle #3 reacts fast to try and disarm the banker."}
 _A3_C1F_["The banker pistol-whips Muscle #3 with her own gun until she collapses."]
 _A3_3_(["Thief #2 sees what&#39;s going on and rushes over to help."])
 _A3_C2_{"Thief #2 tries to reclaim Muscle #3&#39;s weapon."}
 _A3_C2F_["The banker, stronger than he looks, slams Thief #2 against the wall."]
 _A3_4_(["As Muscle #3 gets to her feet, the banker tries to choke her out."])
 _A3_5_(["Thief #2 draws his weapon, pushing it hard into the banker&#39;s temple."])
 _A3_6_(["Robber and Muscle #1 step in to restore order and get things moving."])
 _A4_C2_{"Robber and Thief #2 try to drill the vault door open."}
 _A4_C2P_["The locking mechanism falls away, allowing Robber to kick the door through."]
 _A5_(["Drills at the ready, the team breaks into the deposit boxes, swiftly securing the loot."])
 _A5_1_(["Muscle #1 finds a reinforced door that could be hiding more valuable loot."])
 _A5_C1_{"The banker insists this area is off-limits, so Muscle #3 fetches a hostage."}
 _A5_C1F_["The threat fails as the banker insists the vault&#39;s contents belong to someone dangerous."]
 _A5_2_(["The banker suggests the crew should leave with what they&#39;ve got to avoid further trouble."])
 _A5_C2_{"Muscle #3 grabs the hostage and Muscle #1 threatens to cut him if he doesn&#39;t help."}
 _A5_C2P_["The banker sighs and inputs the passcode, unlocking the door."]
 _A6_(["Inside the secure area, a second reinforced door is discovered."])
 _A6_1_(["The banker claims that the first door must be closed for the second one to open."])
 _A6_C1_{"Facing a dilemma, Robber and Muscle #1 ponder if the banker is lying."}
 _A6_C1P_["For safety, the crew drags the banker along as they step into the secure area."]
 _A7_(["Muscle #3 closes the outer door to initiate the security procedure."])
 _A7_1_(["True to the banker&#39;s word, the second door swings open, revealing even more valuables."])
 _A7_2_(["Curiosity overcomes the team and Robber inadvertently sets off a timed alarm."])
 _A7_C1_{"Muscle #1 dashes to the console as Robber demands the banker’s passcode."}
 _A7_C1P_["Muscle #1 punches in the passcode and deactivates the alarm before it triggers."]
 _A8_(["With the situation under control, the vault is left bare, looted of its treasures."])
 _A8_1_(["The team regroups in the lobby and prepares to make its exit."])
 _A8_2_(["With the bank fully looted, the team&#39;s haul is loaded into the van."])
 _A8_2_Cont_(["Before they can finish, two cop cars pull up to disrupt the operation."])
 _A8_3_(["The team withdraws inside, threatening the hostages to ensure its safe departure."])
 _A8_C1_{"Robber and Thief #1 step outside with hostages to try and secure their departure."}
 _A8_C1P_["When a nervous cop opens fire, Thief #1 uses the hostage as a meatshield."]
 _A8_4_(["With a dead civilian on their hands, the commanding officer urgently orders a ceasefire."])
 _A8S_(["Leveraging the prospect of further casualties, the team safely negotiates its escape."])
 _A1_C2P_["Intimidated, the guards drop their weapons and lower themselves to the floor."]
 _A6_C1F_["Ignoring the warning, the team tries to force the door open, triggering an alarm."]
 _A6_2_(["Thief #2 orders the banker to disable it or he’ll kill a hostage."])
 _A6_3_(["The banker reiterates that the first door must be closed to access the control panel."])
 _A6_4_(["Thief #2 shoves the banker inside and closes the outer door."])
 _A6_5_(["The second door unlocks, revealing a room containing the security control panel."])
 _A7_C2_{"Robber tells Muscle #1 to kill the banker if she becomes stuck inside."}
 _A7_C2F_["The banker sobs loudly, offering no help as the door shuts, trapping Robber."]
 _A7_4_(["As he cowers, the banker reveals that only the police can open the door now."])
 _A10S_(["With the crew informed, they realize they have no choice but to abandon Robber."])
 _A3_C2P_["Thief #2 wrests the gun from the banker and winds him with a knee to the gut."]
 _A4_(["Concerned at the hold-up, Robber and Muscle #1 head over."])
 _A4_1_(["The crew scans the area one last time to ensure it&#39;s clear."])
 _A4_2_(["Robber examines the door to the vault, finding it locked with a keypad."])
 _A4_C1_{"Thief #2 forces his gun into the banker&#39;s mouth, demanding he opens the door."}
 _A4_C1F_["Unintimidated, the banker claims he doesn&#39;t know the access code."]
 _A8_C1F_["A trigger-happy cop nails Thief #1 with a lucky shot to the throat."]
 _A8_5_(["Robber shouts back to his teammates, ordering them to kill two hostages."])
 _A8_6_(["The commanding officer pleads for calm and orders his men to stand down."])
 _A8S2_(["The crew collects their injured teammate and escapes, taking one hostage as a precaution."])
 _A4_C1P_["Given the choice of a bullet to the head or compliance, the banker chooses the latter."]
 _A7_C1F_["Flustered, Muscle #1 inputs the passcode incorrectly, starting a countdown timer."]
 _A7_3_(["Robber rushes into the newly opened vault to see what he can do to help."])
 _A5_C1P_["When presented with a sobbing young woman, the banker complies, opening the locked door."]
 _A7_C2P_["The banker gives in, allowing Robber to drag him through the door as it closes."]
 _A9_(["Trapped with Robber, the banker overrides the timer to unlock the door."])
 _A9_1_(["As soon as the door opens, the team sprints out, leaving the banker behind."])
 _A9S_(["With a solid bag of swag in hand, the team bolts before anything else can go awry."])
 _A1_C1P_["Seeing sense, the guards lower themselves to the ground."]
 _A2_C1P_["Muscle #2 discovers a shivering old man concealed in the last stall."]
 _A3_C1P_["Muscle #3 retrieves the weapon and restrains the banker."]
 _A5_C2F_["The banker smirks and insists that Muscle #1 doesn&#39;t have the guts."]
 _A5_3_(["Frustrated, the team takes their anger out on the banker, beating him severely."])
 _A5_4_(["After being left in a bloody heap, the banker triggers a lockdown, trapping the team!"])
 _A5_5_(["Muscle #2 tries to scare him into giving up the release code but he refuses."])
 _A5F_(["When the cops arrive to investigate, the fractured team is forced to surrender."])
 _A2_C2F_["The pair&#39;s noisy breathing betrays their attempt to draw out any last remaining workers."]
 _A2_7_(["Muscle #2 goes to leave while Thief #1 stays to use the facilities."])
 _A2_8_(["An old man barges in and attacks while Thief #1 is still on the toilet."])
 _A2_9_(["Muscle #2 runs in and ices the old man with a clean shot to the head."])
 _B1_(["Thief #1 drags the man&#39;s corpse from the restroom, leaving a trail of blood."])
 _B1_1_(["Seeing her comrade motionless with shock, Thief #1 reports back to the team."])
 _B1_2_(["Thief #2 helps move the body to a back room, away from the hostages."])
 _B1_3_(["To their surprise, they discover a bank executive lurking in the shadows."])
 _B1_4_(["The executive wails hysterically as Thief #2 tries to drag her out by her collar."])
 _B1_C1_{"Thief #2 assures the woman he&#39;ll kill anyone who gets in his way."}
 _B1_C1F_["This threat pushes the woman too far and she makes a play for Thief #2&#39;s weapon."]
 _B1_5_(["Firing wildly into the air, the banker flees, encountering Muscle #2 in the lobby."])
 _B1_6_(["While attempting to restrain her, Muscle #2 is shot in the stomach."])
 _B1_7_(["Emboldened by the executive&#39;s bravery, the other hostages rise up against the crew."])
 _B1F_(["The hostages escape, forcing the team to abandon the mission before the alarm is raised."])
 _B1_C1P_["Trembling with fright, the executive stops resisting and gets to her feet."]
 _B2_(["After the woman&#39;s wrists are zip-tied, she&#39;s placed with the other hostages."])
 _B2_Cont_(["With the situation under control, the team presses forward with the heist."])
 _B2_1_(["As the cash drawers are emptied, Robber inspects the door to the deposit vault."])
 _B2_2_(["The door is secured with a keypad that requires a passcode to unlock."])
 _B2_C1_{"Muscle #3 grabs one of the bankers and demands she unlocks the door to the vault."}
 _B2_C1P_["The banker, terrified for her life, obeys and inputs the passcode to open the door."]
 _B3_(["The team quickly drills into the deposit boxes, looting the treasures inside."])
 _B3_1_(["Muscle #2 checks on the banker and catches her triggering a silent alarm!"])
 _B3_2_(["With the police now surely on the way, the team is forced to wrap things up."])
 _B3S_(["Leaving the hostages behind, the team escapes before the cops arrive."])
 _A1_C3F_["Trusting his aim, a guard breaks cover and fires upon Muscle #3."]
 _A1_2_(["A shot hits Muscle #3 in the lung, leaving him gurgling, his breath labored."])
 _A1_3_(["Weapons leveled at the guards, the team ceases fire and slowly backs out of the bank."])
 _A1F_(["As Muscle #3 clings to life, the team bolts from the scene, aborting the mission."])
 _A4_C2F_["The team&#39;s direct approach fails, triggering a silent alarm in the process."]
 _A4_3_(["Resorting to brute force, Robber destroys the door with several sharp kicks."])
 _A4_3_Cont_(["The team breaks into the deposit boxes, swiftly securing the loot."])
 _A4_4_(["Upon noticing the arrival of the police, the banker traps the team inside the vault."])
 _A4F_(["With the odds stacked against them, the rest of the crew is forced to surrender."])
 _B2_C1F_["The banker refuses to cooperate, convinced they&#39;re going to kill everyone anyway."]
 _B2_C2_{"Muscle #1 punches the banker and threatens a hostage, hoping to force compliance."}
 _B2_C2F_["The impact knocks the banker unconscious, leaving the team without a passcode."]
 _B2_3_(["Muscle #1 hauls the banker to the keypad, trying to revive her with a slap."])
 _B2_4_(["Unable to wake the banker, Muscle #1 tries to guess the code, triggering an alarm."])
 _B2_5_(["Engrossed in finding an entry method, the team is startled by the arrival of the police."])
 _B2_6_(["Realizing they are totally surrounded, the crew concedes defeat."])
 _B2F_(["Robber steps outside, hands up, offering the team&#39;s surrender to the police."])
 _B2_C2P_["The banker bows to the pressure and opens up the safety deposit vault."]

