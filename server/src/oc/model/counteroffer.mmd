flowchart LR
 _Prelude_(["Raid the gun store and snatch as many high-end weapons as you can."])
 _A1_(["The crew approaches the store discreetly, arriving separately to avoid suspicion."])
 _A1_1_(["Picklock and Engineer pretend to look in the window display."])
 _A1_2_(["Meanwhile, Looter and Hacker discuss their plans to go drinking."])
 _A1_3_(["When the lone customer leaves, Robber makes his way toward the entrance."])
 _A1_C1_{"Robber asks the guard to let him in as the others get ready to pounce."}
 _A1_C1P_["As the guard unlocks the door, Robber shoves him down and the team rushes inside."]
 _A2_(["The security guard is cornered in the office as Picklock locks the entrance."])
 _A2_1_(["Hacker and Engineer drag the shrieking salesperson into the office to join him."])
 _A2_2_(["Looter searches the office for intel on the store&#39;s alarm system."])
 _A2_3_(["Looter finds what she needs and directs Engineer toward the alarm panel."])
 _A2_C1_{"Engineer opens the panel and tries to disable the main alarm system."}
 _A2_C1F_["Engineer severs a wire, but nothing changes. The alarm system remains live."]
 _A2_5_(["Robber picks up a chair and smashes it against the wall."])
 _A2_C2_{"Wielding a chair leg, Robber demands to know how to bypass the alarm system."}
 _A2_C2P_["The salesperson gives in and disables the alarm system with a numerical code."]
 _A3_(["Robber and Looter zip-tie the staff as the others head deeper into the store."])
 _A3_1_(["Hacker and Picklock study the armor display, finding it locked electronically."])
 _A3_C1_{"Hacker boots up the terminal and tries to breach the system using a polymorphic virus."}
 _A3_C1F_["The terminal rejects Hacker’s breach attempt and flashes a lockdown warning."]
 _A3_C2_{"Hacker reboots the terminal and opens the system settings to disable the lockdown."}
 _A3_C2P_["Hacker overrides the lockout, gaining restricted access with a hidden config file."]
 _A3_R3_(["One of the glass cases rises, allowing the crew to take some liquid body armor."])
 _A4_Cont2_(["As the armor is removed, a pressure sensor triggers a store-wide lockdown sequence."])
 _A4_C1_{"Hacker executes a script to freeze the security system and stop the countdown."}
 _A4_C1F_["A built-in failsafe quarantines the script, and the store is locked down tight."]
 _A4_1_(["Engineer investigates the store&#39;s power supply to look for a solution."])
 _A4_2_(["Opening an access panel, Engineer finds a flaw in the internal power routing."])
 _A4_C2_{"Engineer tries to reroute the power and cut supply to the security features."}
 _A4_C2P_["The power reroute works and the locks disengage with a heavy clang."]
 _A5_(["Crisis averted, the crew moves toward the premium weapon stores at the back."])
 _A5_1_(["Inside the first store, the crew finds some weaponry locked inside steel containers."])
 _A5_C1_{"Picklock readies his lockpicks as Robber identifies a high value case."}
 _A5_C1P_["Robber&#39;s eye and Picklock&#39;s skills reward them with a premium stash."]
 _A6_R3_(["A Jackhammer is pulled from the case and held aloft proudly by Picklock."])
 _A6_1_(["Picklock is about to crack into another case when Engineer calls him over."])
 _A6_2_(["Engineer has found a retinal scanner that might be protecting some high-value items."])
 _A6_3_(["Robber and Looter fetch the salesperson and drag her over to the scanner."])
 _A6_C1_{"Looter and Engineer try to calm the woman and use her eye to open the display."}
 _A6_C1P_["The scanner reads her eye, blinks green, and unlocks the door with a smooth hydraulic hiss."]
 _A7_R1_(["Engineer grabs the Type 98 from the rack and cradles it admiringly."])
 _A7S_(["Pleased with their haul, the crew exits the store armed and ready for war."])
 _A6_R4_(["A SIG 552 is pulled from the case and held aloft proudly by Picklock."])
 _A7_R2_(["Engineer grabs the Milkor MGL from the rack and cradles it admiringly."])
 _A1_C1F_["Robber gets in, but Looter slips and the guard braces the door shut."]
 _A1_C2_{"As Robber pulls the guard back, Picklock tries to wedge the door open."}
 _A1_C2P_["Picklock crashes through the entrance, and the crew streams in behind him."]
 _A3_R2_(["The case protecting some flexible body armor rises up, exposing its contents."])
 _A4_Cont1_(["As the armor is removed, a pressure sensor triggers a store-wide lockdown sequence."])
 _A7_R5_(["Engineer grabs the SMAW from the rack and cradles it admiringly."])
 _A3_C1P_["The virus mutates its code, bypasses the login, and gives Hacker control of the case."]
 _A6_R2_(["A Stoner 96 is pulled from the case and held aloft proudly by Picklock."])
 _A2_C1P_["Engineer identifies the control wires and severs them cleanly, disabling the alarm."]
 _A3_C2F_["Hacker is locked out of the BIOS, triggering a full store-wide alarm."]
 _B3_(["Power is cut to the entire store, plunging the team into darkness."])
 _B3_C1_{"Looter searches through the dark, looking for the store&#39;s emergency power switch."}
 _B3_C1P_["Looter finds the control box and flips the switch, bringing power back to the store."]
 _B4_(["Having wasted valuable time, the team prioritizes the gun stores at the back."])
 _B4_1_(["The crew finds the weapons are kept in thick steel containers fitted with cylinder locks."])
 _B4_C1_{"Picklock works rapidly to try and unlock one of the cases."}
 _B4_C1F_["The lock thwarts Picklock&#39;s attempt to crack it, leaving him frustrated."]
 _B4_C2_{"Engineer steps over to help Picklock bust open the case."}
 _B4_C2P_["The pair manage to open not one but two weapon cases!"]
 _B5_R1_(["The first case contains a China Lake grenade launcher."])
 _B5_1_R4_(["Within the second case, Picklock finds a SIG 552 assault rifle!"])
 _B5_1_Cont_(["Buoyed by their success, Engineer tries to crack into the premium weapon stores."])
 _B5_2_(["Robber pries open a wall vent and finds a power panel tucked behind the mesh."])
 _B5_3_(["Engineer steps in, yanks a wire out, and tells Hacker to help reroute the current."])
 _B5_4_(["Hacker grips the exposed end as Engineer shoves it against a nearby terminal."])
 _B5_5_(["A violent jolt erupts from the panel, blasting the pair backward in a shower of sparks."])
 _B5S_(["Realizing they&#39;re fried, the crew grabs the loot and flees, leaving their teammates to sizzle."])
 _A7_R4_(["Engineer grabs the PKM from the rack and cradles it admiringly."])
 _B5_R2_(["The first case contains a Stoner 96 machine gun."])
 _B5_1_R3_(["Within the second case, Picklock finds a Jackhammer shotgun!"])
 _A4_C1P_["Hacker&#39;s override kicks in, halting the sequence and disabling the trigger protocol."]
 _A5_C1F_["Picklock&#39;s attempt to pick the lock fails, leaving the weapon case shut."]
 _A5_C2_{"Looter looks around the store for any useful tools that might help."}
 _A5_C2F_["A thorough search yields nothing, leaving the weapon cases locked tight."]
 _A5_C3_{"Abandoning finesse, Robber and Looter try to smash the weapon case open."}
 _A5_C3F_["Despite repeated slams and kicks, the case refuses to give, its lock still intact."]
 _A5_6_(["The noise draws unwanted attention, and the T.C.P.D. closes in."])
 _A5F_(["Busted with the loot and nowhere left to run, the crew has no choice but to surrender."])
 _B5_R4_(["The first case contains a SIG 552 assault rifle."])
 _B3_C1F_["Looter searches high and low but can’t locate the emergency power switch."]
 _B3_C2_{"Engineer joins Looter to guide him on what to look for."}
 _B3_C2P_["Engineer helps Looter find the control box and restore the store&#39;s power."]
 _B5_R3_(["The first case contains a Jackhammer shotgun."])
 _B5_1_R2_(["Within the second case, Picklock finds a Stoner 96 machine gun!"])
 _A1_C2F_["Picklock keeps the door open but Robber is winded by a gut punch."]
 _A1_C3_{"Looter and Picklock push forward as the guard digs in to hold the door."}
 _A1_C3P_["The door gives way and the crew surges past the guard into the store."]
 _A6_C1F_["Their attempt fails as the woman cries, her eyes flooded with tears."]
 _A7_1_(["Looter threatens to take her eye out if she won&#39;t stop, exacerbating the situation."])
 _A7S2_(["Unable to open the store, the team moves out with what they&#39;ve already acquired."])
 _A6_R1_(["A China Lake is pulled from the case and held aloft proudly by Picklock."])
 _B3_C2F_["Even with Engineer&#39;s help, the power control box remains elusive."]
 _B3F_(["Trapped inside the darkened store, the crew are sitting ducks when the T.C.P.D. shows up."])
 _A5_C3P_["Robber and Looter rain blows on the lid and hinge until the lock finally gives."]
 _A5_2_R3_(["Inside the case, Picklock finds a Jackhammer shotgun!"])
 _A5_3_(["Picklock asks for more time to break into the remaining weapon cases."])
 _A5_4_(["Robber and Engineer overrule him, insisting it&#39;s time to go."])
 _A5S_(["The team exits the store quietly, having secured some valuable items at a 100% discount."])
 _A5_C2P_["Looter finds a drill, allowing Picklock to break through the lock with ease."]
 _A5_2_R4_(["Inside the case, Picklock finds a SIG 552 assault rifle!"])
 _A7_R3_(["Engineer grabs the Negev NG-5 from the rack and cradles it admiringly."])
 _A5_2_R1_(["Inside the case, Picklock finds a China Lake grenade launcher!"])
 _B4_C1P_["Picklock busts two cases in quick succession, much to the team&#39;s delight."]
 _B5_1_R1_(["Within the second case, Picklock finds a China Lake grenade launcher!"])
 _A4_C2F_["Engineer hits the wrong contact and takes a jolt straight through the chest."]
 _A4_3_(["Sparks fly from the panel as Engineer suffers a seizure and the store&#39;s power cuts out."])
 _A4_4_(["Feeling their way through the dark, the crew makes for the exit, but the door won&#39;t budge."])
 _A4F_(["Alerted by the blackout, cops swarm the store and take the crew into custody."])
 _A5_2_R2_(["Inside the case, Picklock finds a Stoner 96 machine gun!"])
 _B4_C2F_["Failing yet again, Picklock punches the case in frustration, breaking his hand."]
 _B4_2_(["With their locksmith injured, Robber calls it—the mission is over."])
 _B4F_(["The crew exits the weapon store with no guns, no gear, and one less working hand."])
 _A2_C2F_["The guard laughs in Robber&#39;s face and spits at him."]
 _A2_6_(["Incensed by the disrespect, Robber jabs the splintered leg into the guard&#39;s throat."])
 _A2_7_(["The salesperson starts screaming, alerting passersby outside."])
 _A2_8_(["With attention drawn and no way to disable the alarm, the crew abandons the mission."])
 _A2F_(["As they try to flee, Hacker and Engineer are nabbed by the authorities."])
 _A1_C3F_["The guard manages to resist the team&#39;s efforts and slam the door shut."]
 _A1_4_(["Turning his attention to Robber, he knocks him down and kicks him half to death."])
 _A1F_(["Seeing their teammate brutalized, the crew retreats before the cops show up."])
 _A3_R1_(["Hacker unlocks the case surrounding a full set of combat armor!"])
 _A4_(["As the armor is removed, a pressure sensor triggers a store-wide lockdown sequence."])

