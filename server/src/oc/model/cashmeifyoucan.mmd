flowchart LR
 _Prelude_(["The crew drives the stolen cash delivery van into the bank&#39;s loading area."])
 _A1_(["Empty cash boxes in hand, they exit the vehicle and enter the bank from the rear."])
 _A1_C1_{"Thief #1 greets the guard, hoping to pass through without incident."}
 _A1_C1F_["The security officer stops him and demands to see some ID."]
 _A1_C2_{"Thief #1 flashes his badge quickly, hoping the guard won&#39;t take a closer look."}
 _A1_C2F_["The guard snatches Thief #1&#39;s ID badge and scrutinizes it carefully."]
 _A1_1_(["The guard asks why Thief #1 looks so different to his photograph."])
 _A1_C3_{"Thief #2 explains that Thief #1 has been taking Ozempic."}
 _A1_C3P_["The guard laughs and allows them to enter the bank."]
 _A2_(["Thief #1 and Thief #2 head to the ATMs."])
 _A2_1_(["Outside the bank, Lookout observes the entrance discreetly from a nearby cafe."])
 _A2_C1_{"Thief #2 tries the key on the first ATM."}
 _A2_C1F_["Thief #2 fails to unlock the ATM—a certain technique is required."]
 _A2_C2_{"Thief #1 snatches the key and attempts to unlock the ATM."}
 _A2_C2F_["Thief #1 also fails, kicking the ATM in anger."]
 _A2_C3_{"Thief #2 tries once more, this time with extreme force."}
 _A2_C3P_["Thief #2 finally unlocks the ATM. Sadly, there&#39;s no cash inside."]
 _A3_(["Thief #2 punches the ATM in frustration."])
 _A3_C1_{"Thief #1 takes the key and tries to unlock the second ATM."}
 _A3_C1P_["The ATM opens up, revealing trays of crisp bills, which the crew empties into a cash box."]
 _A4_C1_{"With the third ATM out of order, Thief #2 takes the key and approaches the next one."}
 _A4_C1P_["The ATM opens, bursting with cash. Thief #2 snatches it up."]
 _A5_(["Lookout sees the manager approaching and calls the team to warn them."])
 _A5_1_(["Lookout trails the manager inside and ponders how to distract her."])
 _A5_2_(["Lookout overhears the manager discussing a missing security van."])
 _A5_C1_{"Lookout distracts the manager with a sob story about needing a loan."}
 _A5_C1F_["The manager brushes off Lookout and continues toward the ATMs."]
 _B1_(["Lookout tackles the manager and shouts to warn his teammates."])
 _B1_1_(["Hearing the commotion, the crew grabs the cash boxes and rushes to the van."])
 _B1_2_(["The guard arrives to intercept the team, having been alerted by the receptionist."])
 _B1_C1_{"The crew finds the side entrance locked, so they try to kick it down."}
 _B1_C1P_["The door gives way, allowing Thief #1 and Thief #2 to flee."]
 _B2_(["Hearing the team escape, Lookout hurries to retrieve the van."])
 _B2_1_(["Lookout arrives at the gate but it won&#39;t open without the guard."])
 _B2_C1_{"Lookout shifts into reverse, preparing to drive through the gate."}
 _B2_C1F_["The van drifts and crashes into the barrier, which becomes lodged in the front fender."]
 _B2_3_(["Lookout reverses the van and runs over the guard, crushing his legs."])
 _B2_4_(["Hearing screams, the team runs to investigate. Lookout freezes in shock."])
 _B2_5_(["Nearby officers arrive at the scene of the accident."])
 _B2F_(["The team is held for questioning about the accident and the cash found in their hands."])
 _A2_C2P_["The ATM yields to the key, but there&#39;s no cash inside."]
 _A3_C1F_["The attempt by Thief #1 is also unsuccessful."]
 _A3_C2_{"Thief #1 tries to open up the ATM using a more careful technique."}
 _A3_C2P_["Thief #1 manages to unlock and open the ATM."]
 _B1_C1F_["Thief #1 and Thief #2 fail to break through the door."]
 _B1_3_(["The security guard initiates a lockdown procedure."])
 _B1F_(["With no way out, the crew is forced to give themselves up when the cops arrive."])
 _A5_C1P_["The manager comforts Lookout as he sobs, buying the team some time."]
 _A6_(["Thief #2 works on the final ATM, but the lock is stiff and the key jams."])
 _A6_C1_{"Thief #2 curses, pulls the key out, and tries again."}
 _A6_C1P_["On the second attempt, Thief #2 unlocks the last ATM."]
 _A6_1_(["Thief #1 helps bag the cash while Lookout occupies the manager."])
 _A7_(["Having emptied the final ATM, the crew packs up and returns to the van."])
 _A7_1_(["The guard raises the barrier and allows the crew to exit."])
 _A7_2_(["After making his excuses, Lookout meets the vehicle by the cafe."])
 _A7S_(["The team escapes with a large haul of pristine, unmarked cash."])
 _A4_C1F_["The key doesn&#39;t work and Thief #2 fails to open the ATM."]
 _A4_C2_{"Thief #1 snatches the key and attempts to unlock the ATM himself."}
 _A4_C2F_["Thief #1&#39;s failure earns a disapproving stare from Thief #2."]
 _A9_(["Lookout calls the crew to inform them of the manager&#39;s arrival."])
 _A9_1_(["Keeping watch, Lookout follows the manager into the building."])
 _A9_2_(["The manager announces a delivery van is missing and declares a lockdown."])
 _A1_C1P_["The security officer grunts, picks his nose, then waves the team through."]
 _B2_C1P_["The van crashes through the gate just in time to escape the guard."]
 _B3_(["Lookout speeds toward the crew and meets them at the rendezvous point."])
 _B3S_(["The team successfully escapes with a bag full of cash."])
 _A1_C2P_["The guard allows the crew to enter the bank."]
 _A6_C1F_["Unable to open the ATM, Thief #2 kicks it and says it&#39;s time to go."]
 _A8_(["Thief #1 and Thief #2 close the cash boxes and return to the van."])
 _A8_1_(["The guard raises the barrier and allows the van to exit."])
 _A8_2_(["Lookout excuses himself and rendezvous with the team by the cafe."])
 _A8S_(["The team escapes with a decent haul of pristine, unmarked cash."])
 _A4_C2P_["Thief #1 unlocks the ATM and packs the money into the case."]
 _A4_1_(["Thief #2 calls Lookout to let her know there&#39;s been a delay."])
 _A4_2_(["Lookout is told to sneak down the side, access the van, and start the engine."])
 _A4S_(["Lookout manages to drive the team away from the scene of the crime."])
 _A2_C1P_["The ATM opens on the first try but there&#39;s no cash inside."]
 _A1_C3F_["The guard doesn&#39;t buy it, so Thief #1 hits him in the head with a cash box."]
 _A1F_(["Before passing out, the guard launches a lockdown, forcing the team to abort the mission."])
 _A3_C2F_["Thief #1 fails to unlock the ATM."]
 _A3_C3_{"Thief #2 suggests they try the business ATM to the rear of the bank."}
 _A3_C3P_["Thief #1 reluctantly agrees to abandon the main set of ATMs."]
 _C1_(["Thief #1 and Thief #2 smile at the receptionist as they pass."])
 _C1_1_(["Seeing no sign of the crew, Lookout enters the bank, assuming the worst."])
 _C1_C1_{"Thief #1 attempts to unlock the business ATM with the key."}
 _C1_C1P_["The ATM yields to Thief #1, opening to reveal a large cache of cash."]
 _C2_(["The cash boxes are filled and the crew makes its way out of the bank."])
 _C2_1_(["Time running out, Lookout rushes to the van and starts the engine."])
 _C2S_(["The barrier is lifted and the team escapes with a reasonable amount of cash."])
 _A3_C3F_["Thief #1 rejects this suggestion and insists on trying again."]
 _A3_2_(["Lookout spots the manager approaching and calls Thief #1."])
 _A3_3_(["Thief #1 ignores the call and focuses on breaking into the ATM."])
 _A3_4_(["Lookout isn&#39;t sure what to do, so he calls Thief #1 again."])
 _A3_5_(["The bank manager walks in on the ATMs being robbed and locks down the building."])
 _A3F_(["With no way out, the crew is forced to give themselves up when the cops arrive."])
 _A2_C3F_["The key snaps in the lock and Thief #1 slaps Thief #2."]
 _A2F_(["With no way to access the ATMs, the crew returns to the van and flees the scene."])
 _C1_C1F_["Again, the key fails. Thief #1 starts to wonder if this is a setup."]
 _C1_2_(["Lookout rushes past the receptionist, ignoring her protests."])
 _C1_3_(["An argument between Lookout and Thief #1 alerts the bank&#39;s staff."])
 _C1_4_(["Lookout runs to the security van and immediately starts the engine."])
 _C1F_(["The crew dashes to the van empty-handed, escaping just before the bank is locked down."])

