 _A8_9_(["Engineer rushes to the basement as the SWAT team moves in."])
 _A8_10_(["Sniper and Lookout leap into one vehicle and speed off."])
 _A8_11_(["Muscle #1 and Muscle #2 try to follow but are shot to pieces inside the car."])
 _A8_12_(["With armed officers hot on his heels, Engineer races through the basement."])
 _A8_13_(["Engineer opens the hatch and tosses one duffel bag down."])
 _A8_14_(["The SWAT rush in and open fire, forcing Engineer to leave the second bag behind."])
 _A8_15_(["Engineer loads the cesium, leaps into the water, and boards the submersible."])
 _A8S3_(["Engineer escapes by a hair&#39;s breadth, the SWAT team unable to follow."])
 _B6_C2F_["Lookout is cut down quickly with a targeted shot to the leg."]
 _B6_6_(["The SWAT team breaches the building and Sniper surrenders."])
 _B6_6_Cont_(["The others flee toward their vehicles but are intercepted by another SWAT team."])
 _B6F_(["A vicious firefight sees the whole crew gunned down, their grand plans unraveled in an instant."])
 _B5_C1F_["The explosion fails to detonate, the truck door remaining firmly fixed shut."]
 _B5_C2_{"Engineer and Bomber inspect the device and try to force a detonation."}
 _B5_C2F_["The bomb finally goes off, the force of the explosion taking everyone by surprise."]
 _B5_2_(["When Engineer and Bomber enter the truck, they realize a grave mistake has been made."])
 _B5_3_(["The explosion has ruptured the cesium stores, unleashing a wave of deadly radiation."])
 _B5F_(["With the cesium compromised and radiation leaking, the heist attempt is quickly abandoned."])
 _B5_C2P_["After fixing a wiring issue, the grenades finally detonate, blowing the door wide open."]
 _A7_C3F_["Engineer takes a direct shot to the head and falls to the ground."]
 _A7_4_(["Muscle #1 grabs the cesium while Muscle #2 covers him and dives into the car."])
 _A7_5_(["The crew panics and abandons their underwater exit plan, attempting to escape by road instead."])
