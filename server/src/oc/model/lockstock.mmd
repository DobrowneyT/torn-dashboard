flowchart LR
 _Prelude_(["Infiltrate the federal jail, trigger a riot, and extract Ethan alive."])
 _A1_(["The team sneaks into the jail&#39;s parking lot and waits for the kitchen crew to arrive."])
 _A1_1_(["As the caterers pull in, the crew blocks the road and orders them to get out."])
 _A1_C1_{"Muscle #1 and Muscle #2 rush the caterers and try to take them down fast."}
 _A1_C1F_["Armed with various utensils, the kitchen staff fight back bravely."]
 _A1_C2_{"The bruisers feign defeat in an attempt to draw the caterers in."}
 _A1_C2P_["Muscle #1 and Muscle #2 surprise the staff with a brutal counterattack, downing them all."]
 _A2_(["Their bodies are stripped and dumped in the back of the catering truck."])
 _A2_1_(["Smuggler, Muscle #1, and Muscle #2 don the caterers&#39; uniforms and staff passes."])
 _A2_2_(["Before the team splits, Smuggler reminds Assassin that there&#39;s one last task to complete."])
 _A2_3_(["Using the lubricant, Smuggler smuggles Assassin&#39;s ecstasy in an intimate location."])
 _A2_4_(["Smuggler, Muscle #1, and Muscle #2 start transporting items to the kitchens."])
 _A2_5_(["Assassin heads to the visitor&#39;s entrance and announces he&#39;s here for a conjugal visit."])
 _A2_C1_{"Assassin tries to stay calm as the guard frisks him thoroughly."}
 _A2_C1P_["The guard fails to discover the drugs, Smuggler having smuggled them nice and deep."]
 _A3_(["Hacker follows, but his virus thumb drive is unexpectedly confiscated."])
 _A3_1_(["Hacker sits in the waiting room while Assassin approaches the desk clerk."])
 _A3_2_(["The clerk confirms Assassin&#39;s conjugal visit and the guard escorts him to trailer three."])
 _A3_3_(["The guard blows Assassin a kiss and closes the trailer door, leaving him to it."])
 _A3_4_(["Assassin retrieves the bag of drugs and hands it over to the inmate."])
 _A3_5_(["The inmate inspects the contents and agrees to help Assassin take out the guard."])
 _A3_C1_{"The prisoner calls the guard back in to help with a problem while Assassin lies in wait."}
 _A3_C1P_["The guard walks in and is choked out from behind by Assassin."]
 _A4_(["Assassin strips off the guard and puts on his uniform."])
 _A4_1_(["Returning to the waiting area, Assassin fetches Hacker and escorts him through."])
 _A4_2_(["Hacker&#39;s virus is returned and Assassin leads him to the control room."])
 _A4_3_(["Hacker uses the dead guard&#39;s pass to unlock the door."])
 _A4_4_(["The sole technician is strangled by Assassin using a wired mouse snatched from the desk."])
 _A4_5_(["Hacker checks a terminal and sees that B-Wing has already been let out to eat."])
 _A4_6_(["Ready to start the riot, Hacker calls the others to tell them to move in."])
 _A4_7_(["Hacker watches on CCTV as the team sets up inside the kitchen."])
 _A4_8_(["Muscle #1 spots Ethan and slaps him on the back, giving the signal to ready himself."])
 _A4_C1_{"Hacker deploys the Armored Virus onto the terminal."}
 _A4_C1F_["The virus enters the system but is contained before it can deploy its payload."]
 _A4_C2_{"Hacker identifies the containment service and tries to disable it."}
 _A4_C2P_["The security measures are thwarted, allowing the virus to infiltrate the security management system."]
 _A5_(["Hacker accesses the suite and opens the doors to A-Wing, C-Wing, and D-Wing."])
 _A5_1_(["As the entire cellblock rushes to the canteen, the guards try to beat the prisoners back."])
 _A5_2_(["Furious at being denied their food, the inmates start rioting."])
 _A5_3_(["The fighting draws closer, forcing the kitchen staff to shut themselves in for safety."])
 _A5_4_(["The shutter jams and the prisoners threaten to invade the kitchen."])
 _A5_C1_{"Muscle #1 and Muscle #2 aid the guards and try to secure the kitchen."}
 _A5_C1P_["A violent struggle ends with the prisoners forced back and the kitchen shutters locked down."]
 _A6_(["After taking a breather, the guard orders the staff into the safety of the supply closet."])
 _A6_1_(["The room clear, Smuggler checks on Ethan while Muscle #1 fetches the scraps bin."])
 _A6_C1_{"Smuggler tries to smuggle Ethan inside the scraps bin without asphyxiating him."}
 _A6_C1F_["Ethan struggles to breathe under the weight of the scraps and bursts free from the bin."]
 _A6_C2_{"Smuggler attempts to smuggle Ethan more comfortably inside the bin."}
 _A6_C2F_["Upon reaching the guard, Ethan coughs and squirms, revealing his presence."]
 _A6_2_(["Muscle #1 grapples with the guard but she still manages to raise the alarm."])
 _A6_3_(["A security team arrives to back up the guards, forcing the crew into a showdown."])
 _A6_C3_{"Smuggler, Muscle #1, and Muscle #2 try to fight the guards off."}
 _A6_C3P_["The guards are resisted, but Smuggler and Ethan are pushed back into the kitchen."]
 _A7_4_(["Smuggler finds an extraction vent, but the route is blocked by a spinning fan."])
 _A7_5_(["Smuggler calls Hacker and tells him to shut the extractors down."])
 _A7_C3_{"Hacker tries to turn off the extractor while Smuggler smuggles Ethan into the vent."}
 _A7_C3P_["Smuggler helps Ethan through the vent safely, and they emerge outside."]
 _A8_4_(["As Assassin and Hacker go to leave, they are intercepted by a group of guards."])
 _A8_5_(["Ethan and Smuggler make it back to the caterer&#39;s truck and start the engine."])
 _A8S3_(["Realizing the others were caught, Smuggler bolts, the sole survivor of a successful mission."])
 _A1_C1P_["The whole team of staff is beaten senseless in a display of brutal savagery."]
 _A4_C1P_["The virus resists countermeasures and embeds itself within the jail&#39;s security management system."]
 _A6_C1P_["The team manages to get Ethan past the door guard and near to the exit."]
 _A7_0_(["Muscle #2 re-opens the shutters to divert the guard&#39;s attention."])
 _A7_(["Reaching the final door, Muscle #2 finds it has been locked down due to the riot."])
 _A7_1_(["Hacker is called and asked to provide a solution."])
 _A7_C1_{"Hacker looks for a way to override the final door lock."}
 _A7_C1F_["Hacker fails to bypass the lockdown protocol, leaving the team trapped."]
 _A7_2_(["Several guards show up and demand the team returns to the kitchen."])
 _A7_C2_{"Hacker hunts for a workaround as the muscle fights off the guards."}
 _A7_C2F_["The door remains fastened shut as the bruisers are beaten to a pulp by the guards."]
 _A7_3_(["Smuggler flees to the kitchen with Ethan and barricades the door."])
 _A3_C1F_["The guard enters but sees Assassin hiding and draws his gun."]
 _A3_C2_{"Assassin and the prisoner try to stop the guard from discharging his weapon."}
 _A3_C2F_["The gun goes off, drawing several guards over to the trailer."]
 _A3_6_(["The guards beat the inmate severely while dragging Assassin back outside."])
 _A3_7_(["Hacker sees the beating and alerts his teammates to the situation."])
 _A3F2_(["With their distraction plan thwarted, the jailbreak is called off, Ethan remaining in custody."])
 _A7_C1P_["The lockdown protocol is overridden, allowing Hacker to open the external door."]
 _A8_(["The trio races toward the catering vehicle before anyone stops to question them."])
 _A8_1_(["Ethan is bundled inside as Assassin and Hacker arrive for the ride."])
 _A8S_(["The team drives off in the stolen truck with the jailbird in their custody."])
 _A6_C2P_["Ethan remains quiet inside the bin as Smuggler wheels him away from the kitchen."]
 _A3_C2P_["The guard is disarmed and knocked out with an elbow strike to the nose."]
 _A6_C3F_["The federal jail guards prove too tough for the team and brutalize them in the corridor."]
 _A6F_(["The others try to leave but are caught on their way out, their jailbreak broken by the guards."])
 _A7_C2P_["Muscle #1 and Muscle #2 keep the guards at bay while Hacker works on the door."]
 _A8_2_(["The entrance is unlocked, so Smuggler pulls Ethan out and they make a run for it."])
 _A8_3_(["Assassin and Hacker meet them at the catering truck and they all pile in."])
 _A8S2_(["Muscle #1 and Muscle #2 are left behind as the team escapes with valuable human cargo."])
 _A2_C1F_["Smuggler&#39;s poor technique leaves the drug bag dangling precariously."]
 _A2_C2_{"The guard notices Assassin&#39;s nervousness and starts to question him."}
 _A2_C2P_["Assassin holds firm and is granted entry into the visitor&#39;s area."]
 _A5_C1F_["The criminal hordes are too much for Muscle #1 and Muscle #2 and they are pushed back."]
 _A5_C2_{"Muscle #1 and Muscle #2 desperately arm themselves with anything they can find."}
 _A5_C2P_["The prisoners are beaten back with tenderizers, allowing Muscle #1 to close the shutter."]
 _A5_C2F_["A stand-off emerges as the prisoners also start tooling up."]
 _A5_C3_{"Smuggler and Ethan grab weapons and join in, bracing themselves for a savage scrap."}
 _A5_C3F_["In the ensuing melee, Ethan is killed and the team is butchered by the inmates."]
 _A5_5_(["Hacker throws up while watching this back at the terminal."])
 _A5F_(["Assassin and Hacker sneak away, Ethan&#39;s death bringing their plan to an abrupt end."])
 _A4_C2F_["The containment service rejects the intrusion and strengthens its quarantine around the virus."]
 _A4_C3_{"Running out of time, Hacker tries to hack the system manually."}
 _A4_C3F_["A jail-wide alert is triggered by the attempt, flooding the control area with guards."]
 _A4_9_(["Assassin and Hacker are discovered and arrested, neither putting up much of a fight."])
 _A4F_(["The kitchen team fulfills the delivery and leaves, having waited for a riot that never came."])
 _A1_C2F_["The ruse fails as the catering team holds its ground and calls for help."]
 _A1_C3_{"Assassin sneaks around to aid her team with a stealth attack."}
 _A1_C3P_["Distracted by Assassin&#39;s clinical neck snap, the caterers are swiftly taken out."]
 _A5_C3P_["The fearsome foursomes battle the federal inmates and pushes them back out of the kitchens."]
 _A7_C3F_["Hacker stops the fan but the system reboots just as Ethan crawls through."]
 _A7F_(["Ethan is torn apart and the whole team arrested as their mission is cut to pieces."])
 _A2_C2F_["Under duress, the ecstasy bag almost drops from Assassin, forcing him to clench."]
 _A2_6_(["The guard tells Assassin he will be strip searched before being allowed in."])
 _A2_7_(["In the examination room, the guard pulls on a thick rubber glove."])
 _A2_C3_{"As the guard approaches from the rear, Assassin prepares an attack."}
 _A2_C3P_["Assassin grabs a chair and smashes it into the guard&#39;s skull, knocking him out."]
 _A3_C3_{"A second guard enters to see what&#39;s going on, forcing Assassin to adapt."}
 _A3_C3F_["Assassin tries to surprise the second guard but is far too slow."]
 _A3_8_(["Their fight spills out into the corridor, alerting the guards and causing Hacker to run."])
 _A3F_(["Hacker calls the others and tells them to leave, their jailbreak having been uncovered."])
 _A4_C3P_["Hacker forces the system into maintenance mode and hijacks the security management system."]
 _A3_C3P_["Assassin ambushes the second guard with a gut punch before strangling her to death."]
 _A3_9_(["Assassin strips one of the guards and steals their pass before locking the door behind him."])
 _A2_C3F_["Assassin goes to grab a chair but is wrestled to the ground and subdued."]
 _A2_8_(["Hacker overhears the commotion and leaves the waiting area to inform his teammates."])
 _A2F_(["The others return to the catering van and depart, their mission exposed before it had begun."])
 _A1_C3F_["Unknown"]

