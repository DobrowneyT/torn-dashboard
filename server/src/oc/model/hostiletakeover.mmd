 _Prelude_(["Attack the stock exchange, breach the control room, and obtain the data while trading is suspended."])
 _A0_(["The crew arrives at the stock exchange in two separate vehicles."])
 _A1_(["Cat Burglar leads Ethan and the tech team east to find the window cleaner&#39;s platform."])
 _A1_1_(["As expected, the area is protected by a security guard, so they lay low by a coffee truck."])
 _A1_2_(["Outside the main entrance, Muscle retrieves his grenade launcher from the car."])
 _A1_3_(["Negotiator leads the assault team toward the T.C.S.E.&#39;s main entrance."])
 _A1_C1_{"The others stand guard as Muscle prepares to fire."}
 _A1_C1P_["Muscle launches a grenade at the stock exchange entrance."]
 _A2_(["The grenade obliterates the doorway, wiping out the security team inside."])
 _A2_1_(["Stockbrokers panic as the trading floor erupts into chaos."])
 _A2_2_(["The team strolls through the wreckage and starts gunning down random traders."])
 _A2_3_(["Some traders fight back, so the team attempts to corral them."])
 _A2_C1_{"Kidnapper and Negotiator herd the traders and try to take them hostage."}
 _A2_C1P_["The traders back down as Kidnapper promises to spare their lives."]
 _A3_(["Hostages secured, Muscle picks one and tells him to move forward."])
 _A3_1_(["Muscle holds him still while Kidnapper hands him the nail bomb."])
 _A3_2_(["Negotiator connects the igniter cord, the bomb set to detonate if the hostage lets go."])
 _A3_3_(["Having drawn attention, Negotiator makes a call to the cops to invite them to negotiate."])
 _A3_4_(["The tech team takes advantage and scales the building using the cleaning platform."])
 _A3_C1_{"Reaching level 19, Engineer helps Cat Burglar look for a way inside."}
 _A3_C1P_["Engineer boosts Cat Burglar up to an air vent, allowing him to remove the cover."]
 _A4_(["After dropping into an office, Cat Burglar opens a window to let the others in."])
 _A4_1_(["The team finds the operations room empty, its technicians already evacuated."])
 _A4_2_(["Hacker takes a seat at the terminal and confirms that the T.C.S.E. has halted trading."])
 _A4_3_(["Ethan shows Engineer the power distribution unit and opens the panel."])
 _A4_C1_{"Engineer attempts to fit the PSU without triggering an alert."}
 _A4_C1P_["Engineer slots the low-voltage PSU into the panel, the system holding steady."]
 _A5_(["With the PSU installed, Ethan tells Engineer to remove a different power unit on his mark."])
 _A5_1_(["Ethan opens another server and instructs Hacker to load the virus once he&#39;s restarted."])
 _A5_2_(["The mark is given, Engineer pulls a PSU, and Ethan restarts during the power dip."])
 _A5_C1_{"Hacker deploys the virus onto the control terminal before the power falls too much."}
 _A5_C1F_["Hacker&#39;s virus fails to deploy as the power drops precariously close to the limit."]
 _A5_C2_{"Hacker tries to rewrite the code on the fly and install the virus onto the terminal."}
 _A5_C2P_["The virus tunnels into the system, revealing a backlog of buy and sell orders."]
 _A5_R2_(["Ethan logs 83.18% of the orders onto Cat Burglar&#39;s drive before the control terminal shuts down."])
 _A6_(["Hacker takes possession of the drive as Engineer updates the assault team."])
 _A6_1_(["The hostages are marched toward the entrance where the cops are waiting outside."])
 _A6_2_(["Backed by sharpshooters, the police negotiator asks the team for their terms."])
 _A6_C1_{"Negotiator attempts to secure the team&#39;s exit through bargaining."}
 _A6_C1F_["Kidnapper plays hardball but the negotiator rejects his outrageous demands."]
 _A6_C2_{"Negotiator tries to compromise without looking weak to rescue the situation."}
 _A6_C2F_["The police negotiator smells blood and tells Negotiator the negotiations are over."]
 _A6_C3_{"Negotiator brings a hostage outside and Muscle threatens to snap his neck."}
 _A6_C3P_["The threat works, allowing Negotiator to exchange a rooftop chopper for half the hostages."]
 _A7_(["The assault team forces the captives into the elevators."])
 _A7_1_(["Reaching the roof, they reconvene with the others and await their helicopter transport."])
 _A7_2_(["When the helicopter lands, two SWAT teams emerge from the elevators."])
 _A7_3_(["The police negotiator steps forward to handle the handoff."])
 _A7_C1_{"Kidnapper tries to keep the wired hostage calm while Negotiator finalizes the exchange."}
 _A7_C1P_["The bomb carrier is reassured and told to walk slowly toward the police officers."]
