flowchart LR
 _Prelude_(["Infiltrate the casino, establish our cover, and trigger the vault alarm."])
 _A1_(["Driver pulls up by the casino and parks under the ventilation duct."])
 _A1_C1_{"Cat Burglar drags a crate into place, climbs on top, and tries to jimmy open the vent."}
 _A1_C1F_["Despite considerable effort, Cat Burglar fails to pry open the vent."]
 _A1_C2_{"Seeing Cat Burglar struggle, Imitator tries to help."}
 _A1_C2P_["With Imitator&#39;s assistance, the vent finally pops open."]
 _A2_(["Driver steps out to hoist Cat Burglar into the duct before they&#39;re spotted."])
 _A2_1_(["Driver returns to the van to prepare for the next step."])
 _A2_2_(["Cat Burglar drops down into the storeroom and sneaks silently through the kitchen."])
 _A2_2_Cont_(["On Cat Burglar&#39;s signal, Driver drives to the employee entrance."])
 _A2_3_(["Driver uses a smoke grenade to fake an issue with the van’s engine."])
 _A2_4_(["Frustrated drivers start honking, forcing the guard to leave her post and investigate."])
 _A2_4_Cont0_(["Cat Burglar takes advantage of the commotion and enters the security office."])
 _A2_4_Cont_(["Seeing smoke billowing from the engine, the guard tells Driver to pop the hood."])
 _A2_C1_{"Driver says he saw sparks and that opening the hood would be dangerous."}
 _A2_C1P_["The guard backs down and tells Driver to call a tow truck."]
 _A3_(["Meanwhile, Cat Burglar searches the guard&#39;s workstation for a password."])
 _A3_1_(["Driver pretends to call for a tow, using the chance to update Cat Burglar."])
 _A3_C1_{"Finding a sticky note in the drawer beneath, Cat Burglar tries the password HamArea1995."}
 _A3_C1F_["The password fails, triggering an alert on the guard&#39;s phone."]
 _A3_2_(["The guard heads back to her post to investigate the breach attempt."])
 _A3_3_(["Cat Burglar is discovered while trying to access the guard&#39;s terminal."])
 _A3_4_(["Cat Burglar explains he&#39;s merely a technician applying an important system update."])
 _A3_5_(["The guard demands to see Cat Burglar&#39;s ID badge."])
 _A3_5_Cont_(["When Cat Burglar claims to have misplaced his pass,  he&#39;s escorted off the premises."])
 _B1_(["Realizing their mission has gone awry, Driver returns to the others."])
 _B1_1_(["After devising a new plan, Driver lifts Hacker up into the vent."])
 _B1_1_Cont_(["He sneaks to the server room while Imitator heads to the employee entrance."])
 _B1_2_(["Imitator flashes his pass and says he&#39;s booked for a server maintenance job."])
 _B1_2_Cont_(["The guard checks the system and insists there is no record of an appointment today."])
 _B1_C1_{"Imitator asks the guard to call the IT department to confirm the booking."}
 _B1_C1F_["Wary after the earlier intrusion, the guard decides to double check with her supervisor."]
 _B1_C2_{"Imitator insists the issue cannot wait and walks through the barrier."}
 _B1_C2P_["Swayed by Imitator&#39;s confident bluff, the guard escorts him to the server room."]
 _B2_(["The teammates reunite in the server room and get to work."])
 _B2_1_(["Hacker finds the security server and accesses it using a terminal."])
 _B2_C1_{"Hacker begins a brute force attack on the database&#39;s outer security layer."}
 _B2_C1F_["The intrusion is blocked by an adaptive firewall algorithm."]
 _B2_2_(["Running out of options, Hacker pulls Imitator in to help."])
 _B2_C2_{"He asks Imitator to temporarily disconnect a network cable on his command."}
 _B2_C2P_["Imitator&#39;s timed network disruption lets Hacker breach the database&#39;s core."]
 _B3_(["Hacker adds the team&#39;s identities to the casino&#39;s employee database."])
 _B3_1_(["While Hacker works, Imitator heads into the office to look for more intel."])
 _B3_2_(["During his search, Imitator encounters a technician returning to his desk."])
 _B3_C1_{"When challenged, Imitator tells him he is performing a high-level security audit."}
 _B3_C1P_["Imitator&#39;s calm and authoritative tone convinces the technician of his legitimacy."]
 _B4_(["The technician excuses himself to check the schedule at his station."])
 _B4_1_(["Returning to the server room, Imitator informs Hacker that they have company."])
 _B4_2_(["The crew go to leave, informing the technician that their audit is complete."])
 _B4_4_(["The technician demands documentation of their audit activities."])
 _B4_C1_{"Hacker tries to intimidate the technician into backing down."}
 _B4_C1F_["Unfazed, by Hacker&#39;s attitude, the technician stomps out of the room to get help."]
 _B4_5_(["With their exit route blocked, the team look for an alternative way out."])
 _B4_5_Cont_(["Following Cat Burglar&#39;s directions, they escape through the storeroom vent."])
 _B4S_(["The team piles into the vehicle and makes a hasty getaway before their plot is uncovered."])
 _A2_C1F_["The guard laughs and calls out Driver on his bullshit."]
 _A2_C2_{"Driver asks the guard to keep watch so he can check something under the vehicle."}
 _A2_C2P_["The guard sighs and reluctantly waits for Driver to investigate."]
 _B1_C1P_["Hacker answers the call and convinces the guard to let his teammate through."]
 _B4_C1P_["With a cold tone, Hacker tells the techie the findings are above his paygrade."]
 _B5_(["The cowed technician backs off, allowing the team to leave."])
 _B5S_(["They rejoin the others and speed off in the van, the first phase of the heist complete."])
 _A3_C1P_["The password works, granting Cat Burglar access to the workstation."]
 _A3_6_(["Cat Burglar edits the appointment calendar to add a server maintenance visit."])
 _A4_(["Having finished the task, Cat Burglar heads back to the kitchen."])
 _A4_1_(["They grabs a photo of the casino&#39;s fire evacuation plan, knowing it will prove useful."])
 _A4_2_(["Cat Burglar pauses in the storeroom, awaiting the signal to leave."])
 _A4_3_(["When the smoke clears, Driver feigns relief that the issue is resolved."])
 _A4_4_(["Driver starts the engine and the guard returns to her post."])
 _A4_5_(["Driver loops back around to collect Cat Burglar as the others move into position."])
 _A4_6_(["Hacker and Imitator stride in, stating they’ve been booked for a maintenance job."])
 _A4_7_(["The guard reviews the appointment log and grants them access to the server room."])
 _A4_C1_{"Hacker attempts to breach the HR database and inject a stealth virus."}
 _A4_C1F_["Hacker&#39;s virus fails to penetrate the system&#39;s advanced security protocols."]
 _B2_C1P_["The database defenses finally crack, giving Hacker full access."]
 _B3_C1F_["The technician remains unconvinced and insists on calling his supervisor."]
 _B3_3_(["Imitator alerts Hacker to the situation, directing him to take action."])
 _B3_C2_{"Hacker scrambles to block the call before the supervisor picks up."}
 _B3_C2F_["Despite Hacker&#39;s efforts, the call goes through."]
 _B3_6_(["After confirming the intrusion with his boss, the technician rushes to alert security."])
 _B3_7_(["When the security guard arrives the crew try to fight their way out, failing miserably."])
 _B3F_(["With no sign of their teammates, the others agree to abandon the mission."])
 _A2_C2F_["The guard refuses and tells Driver she&#39;s heading inside to call a tow truck."]
 _B2_C2F_["Imitator&#39;s mistimed cable pull triggers an immediate system alert."]
 _B2_3_(["Responding to the alert, several guards enter the server room."])
 _B2F_(["With nowhere to run, Hacker and Imitator are forced to surrender."])
 _A1_C1P_["Cat Burglar pops the vent open silently."]
 _A1_C2F_["A loud clang echoes as the vent pings open, catching the ear of a nearby guard."]
 _A1_2_(["As the guard gets closer, Driver panics and lobs a smoke grenade."])
 _A1F_(["Under cover of smoke, the team escapes to the van and vanishes from the scene."])
 _B1_C2F_["The guard pulls a gun out and tells Imitator to stop."]
 _B1_3_(["Sensing she&#39;s a hothead, Imitator turns heel and runs out of the casino."])
 _B1_4_(["When Hacker emerges to see what&#39;s happened, the guard demands his ID at gunpoint."])
 _B1_5_(["Hacker&#39;s lack of identification sees him arrested for trespassing."])
 _B1F_(["The rest of the crew abandons the mission before they too are arrested."])
 _B3_C2P_["Hacker reroutes signals, blocking the outgoing call through the server&#39;s network."]
 _B3_4_(["Still suspicious, the technician steps away to speak to the front desk guard."])
 _B3_5_(["Wary of being stopped, the crew take an alternate escape route out through the vent."])
 _A4_C1P_["The virus takes root, allowing Hacker to plant the team&#39;s false credentials."]
 _A5_(["Hacker then gains access to the casino vault&#39;s high-level security system."])
 _A5_1_(["Finding the alarm can&#39;t be disabled, Hacker opts to trigger it deliberately."])
 _A5_2_(["Imitator loiters in the corridor, ready to observe the security team&#39;s response."])
 _A5_C1_{"Hacker tries to spoof the vault&#39;s sensor data to trigger an alert."}
 _A5_C1F_["Hacker&#39;s packet injection triggers a system alert, drawing security to investigate."]
 _A5_C2_{"Imitator tries to convince the guard that an authorized test is underway."}
 _A5_C2P_["The ruse succeeds when Imitator invites the guard in to check for himself."]
 _A5_6_(["With the guard’s trust secured, he asks the team if they&#39;ve passed the inspection."])
 _A6_3_(["Imitator reminds the guard that protocol requires him to escort them to the exit."])
 _A6_4_(["The guard leads them out, unaware he&#39;s been manipulated."])
 _A6S_(["The team regroups at their vehicle, having narrowly avoided discovery."])
 _A5_C2F_["The guard calls Imitator&#39;s bluff and contacts the IT supervisor for confirmation."]
 _A5_3_(["The IT supervisor arrives, confirming no maintenance was scheduled."])
 _A5_4_(["The guard restrains Imitator and raises a full intruder alert."])
 _A5_5_(["Casino security storm the server room, catching Hacker at the terminal."])
 _A5F_(["Hearing the alert, Driver drives off, realizing the mission is a bust."])
 _A5_C1P_["Hacker&#39;s packet injection succeeds, mimicking a vault breach."]
 _A6_(["The guards react to the alert, revealing their movements and the vault’s location."])
 _A6_1_(["Another guard confronts Imitator and demands to know his duties and clearance level."])
 _A6_C1_{"Imitator tries to bluff his way out of it using technical jargon."}
 _A6_C1P_["Imitator&#39;s confident tech-speak and forged credentials convince the guard to move on."]
 _A7_(["Hacker erases all traces of his activity and heads for the exit."])
 _A7_1_(["Hacker and Imitator walk out unchallenged and rejoin the team at their vehicle."])
 _A7S_(["Intel acquired, the team withdraws from the casino fully prepared for the main event."])
 _A6_C1F_["Suspicious of Imitator&#39;s demeanor, the guard pushes inside and confronts Hacker."]
 _A6_2_(["The hacker explains he was conducting an authorized security response test."])

