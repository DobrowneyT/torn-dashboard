flowchart LR
 _Prelude_(["Draw out the EMTs and distract them long enough to raid their ambulance."])
 _A1_(["Entering the trailer park, the crew gathers in a quiet spot."])
 _A1_1_(["Pickpocket makes an emergency call, claiming his neighbor is seriously ill."])
 _A1_2_(["Decoy hides behind a trailer and smears himself with dirt."])
 _A1_3_(["The ambulance arrives, and Pickpocket gestures for the EMTs to follow him."])
 _A1_4_(["As the EMTs approach, Decoy prepares to put on a show."])
 _A1_C1_{"Decoy fills his mouth with shaving foam and tries to look sick."}
 _A1_C1P_["The EMTs see Decoy foaming at the mouth and immediately back off."]
 _A2_(["Keeping their distance, the EMTs discuss how to handle the patient."])
 _A2_1_(["Pickpocket informs them that Decoy may have taken a lot of drugs."])
 _A2_2_(["As Decoy starts clawing at his face, Pickpocket spots an opportunity."])
 _A2_C1_{"Pickpocket tries to dip into an EMT&#39;s bag without being spotted."}
 _A2_C1P_["The zip is casually eased open, revealing a selection of medical items."]
 _A2_R2_(["Five syringes of morphine are stolen."])
 _A3_(["Decoy sprints off to the south, drawing the EMTs away."])
 _A3_1_(["With the medics occupied by Decoy&#39;s antics, Picklock scrutinizes the ambulance."])
 _A3_C1_{"Picklock tries to pick open the ambulance doors."}
 _A3_C1F_["The lock resists Picklock&#39;s attempt to pick his way in."]
 _A3_C2_{"Moving to the side door, Picklock tries his luck with a different lock."}
 _A3_C2P_["Picklock pulls open the side door and unlocks the rear doors using a button."]
 _A3_R2_(["Three first aid kits are stolen from an unlocked upper cabinet."])
 _A4_(["Picklock finds the bulk of the supplies stowed in a cabinet secured by a barrel lock."])
 _A4_1_(["Picklock texts Pickpocket to tell him to look for a set of keys."])
 _A4_2_(["Pickpocket crouches by the EMTs as they continue to treat Decoy."])
 _A4_C1_{"Spotting the tubular supply key, Pickpocket tries to snatch it."}
 _A4_C1P_["Pickpocket unhooks the tubular key from the EMT&#39;s keychain."]
 _A5_(["The EMTs tell Pickpocket that Decoy must be prepared for transportation."])
 _A5_1_(["One of the EMTs goes to fetch some sedatives from the ambulance."])
 _A5_2_(["Pickpocket delays her by revealing that Decoy is mentally deranged."])
 _A5_C1_{"Decoy plays up to the role and tries to occupy the EMTs with another display of insanity."}
 _A5_C1F_["Decoy starts rambling incoherently, but the EMT heads for the ambulance anyway."]
 _A5_C2_{"Decoy attempts to escalate the situation with another diversion."}
 _A5_C2P_["Decoy soils himself and starts flinging excrement around."]
 _A6_6_(["The EMTs chase Decoy, allowing Pickpocket to sneak back to the ambulance."])
 _A6_7_(["Pickpocket passes the tubular key to Picklock, who unlocks the cabinet."])
 _A6_R2_(["A box of medical supplies and a large case of morphine are stolen from the ambulance."])
 _A6_2_(["Picklock and Pickpocket stow their haul in a nearby dumpster for later retrieval."])
 _A6_3_(["The pair hide as Decoy is escorted over to the ambulance."])
 _A6_4_(["Decoy is wrestled onto a gurney and strapped down tight."])
 _A6_5_(["The rear doors are locked as the EMTs prepare to leave."])
 _A6_C1_{"Picklock rushes over and tries to rescue Decoy."}
 _A6_C1F_["Picklock fails to pick the lock in time and the ambulance pulls away."]
 _A7S2_(["The others retrieve their loot as Decoy is driven off and handed over to the cops."])
 _A2_C1F_["One of the EMTs turns and almost catches Pickpocket in the act."]
 _A2_C2_{"The medics continue treating Decoy, allowing Pickpocket to make another attempt."}
 _A2_C2P_["Pickpocket reaches in and robs a handful of meds from the bag."]
 _A3_C1P_["With a clink and a twist, Picklock picks his way into the ambulance."]
 _A3_R1_(["Four first aid kits are swiped from an unlocked lower cabinet."])
 _A5_C1P_["Decoy goes feral, ripping off his clothes and sprinting around naked."]
 _A6_(["As the EMTs give chase, Pickpocket sneaks back to the ambulance."])
 _A6_1_(["Pickpocket hands Picklock the tubular key, allowing him to unlock the cabinet."])
 _A6_R1_(["Two full boxes of medical supplies are pilfered from the ambulance."])
 _A6_C1P_["Picklock&#39;s lightning fast hands unlock the rear doors to free Decoy."]
 _A7S_(["After retrieving their stash, the team exits the trailer park with the stolen meds."])
 _A2_R1_(["Six syringes of morphine are discreetly pocketed."])
 _A3_R3_(["Five small first aid kits are taken from the wall rack."])
 _A4_C1F_["Catching the move, the EMT grabs Pickpocket&#39;s arm and drives him away."]
 _A4_3_(["Pickpocket punches the EMT, prompting his colleague to flee."])
 _A4_4_(["Decoy and Pickpocket follow the EMT to the ambulance."])
 _B4_2_(["The EMT grabs a gun from the cab of the ambulance and starts aiming it with intent."])
 _B4_3_(["Forcing the crew to back off, she locks herself inside the ambulance and radios for help."])
 _B4_C1_{"Decoy diverts her attention while Picklock tries to pick the door lock."}
 _B4_C1F_["The EMT notices Picklock and aims her gun toward them."]
 _B4_C2_{"Picklock and Decoy switch places to let Picklock sneakily pick the other door."}
 _B4_C2P_["Picklock is able to pick open the door under the EMT&#39;s nose and grab her gun."]
 _B5_(["Pickpocket rushes in to help Picklock wrestle the woman under control."])
 _B5_1_(["She is eventually subdued, allowing the crew to finish the robbery."])
 _B5_2_(["With the supply cabinet secured with a barrel lock, Picklock searches the EMT for keys."])
 _B5_3_(["Her keychain holds a tubular key, but the shaft is bent, rendering it unusable."])
 _B5_C1_{"Pickpocket takes the EMT&#39;s gun and tries to blast the cabinet open."}
 _B5_C1F_["Despite multiple shots, the lock refuses to budge."]
 _B5_C2_{"Picklock shows Pickpocket where to aim to destroy the lock&#39;s mechanism."}
 _B5_C2P_["A more precise shot sees the lock burst apart and the cabinet swings open."]
 _B5_R1_(["Inside, the crew finds a full box of medical supplies and a few syringes of morphine."])
 _B6_(["Just as they&#39;re about to leave, the cops show up, forcing the crew into hiding."])
 _B6_C1_{"Decoy runs off to distract the cops while the others escape."}
 _B6_C1P_["The cops see Decoy and give chase as they hops the fence and flees."]
 _B7_(["Picklock and Pickpocket flee with the loot, running through traffic to escape."])
 _B7S_(["All three teammates evade capture, having secured a useful cache of medical supplies."])
 _A1_C1F_["Decoy&#39;s lackluster performance fails to convince the EMTs, and they go to leave."]
 _A1_C2_{"Decoy doubles down on the crazy."}
 _A1_C2P_["When Decoy starts screaming and punching himself, the EMTs take notice."]
 _A2_R3_(["Four syringes of morphine are spirited away."])
 _B4_C1P_["Decoy&#39;s distraction allows Picklock to pick the lock and grab the EMT&#39;s weapon."]
 _B5_C1P_["The lock shatters into pieces as Pickpocket unloads a full clip into the cabinet."]
 _A2_C2F_["Pickpocket&#39;s lumbering effort sees him caught in the act."]
 _A2_3_(["Realizing they&#39;re being set up, the EMTs make their excuses and leave."])
