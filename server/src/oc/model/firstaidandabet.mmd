 _B6_1_(["Picklock and Pickpocket try to find somewhere to hide."])
 _B6_C2_{"Reaching a locked trailer, Picklock attempts to pick her way inside."}
 _B6_C2P_["Picklock bypasses the lock and opens the door, allowing them to lay low."]
 _B7_1_(["The cop scours the area but finds nothing."])
 _B7S2_(["Once the cops have left, the crew leave quietly, with Decoy destined for the cells."])
