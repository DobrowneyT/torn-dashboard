flowchart LR
 _Prelude_(["Ambush the mistress&#39;s car, take out her guards, and send a message to the mob boss."])
 _A0_(["Lookout positions himself atop the building overlooking the intersection."])
 _A1_(["Right on time, the mistress nears the ambush point, traveling in the back of a sedan."])
 _A1_1_(["Lookout alerts the ground team that the target is in the second vehicle."])
 _A1_2_(["Muscle #2 rams the first car as Sniper shoots out the second car&#39;s tires."])
 _A1_3_(["As both cars come to a halt, the team leaps out of the truck, guns at the ready."])
 _A1_4_(["The mistress and her guards exit the car, pistols drawn, forcing the team to take cover."])
 _A1_5_(["When Muscle #3 approaches, one bodyguard steps into the road and starts firing."])
 _A1_C1_{"Lookout notices the guard reloading, telling Muscle #2 to take action."}
 _A1_C1F_["Lookout yells to distract the gangster but he remains focused."]
 _A1_C2_{"Lookout lobs a stone at the goon, hoping to allow Muscle #1 to open fire."}
 _A1_C2P_["The guard glances up, giving Muscle #1 the opening he needs to take him down."]
 _A2_(["As the team moves in on the target, the guards return fire, forcing the crew to back off."])
 _A2_1_(["With their vehicle immobilized, the guards whisk the mistress down the alleyway."])
 _A2_2_(["Muscle #2 follows the target to a cafe, only to be held hostage by a guard."])
 _A2_3_(["The mobster has Muscle #2 in a rear naked choke, warning he&#39;ll break his neck."])
 _A2_C1_{"Hidden on a rooftop, Sniper zeroes in, adjusting the scope for a perfect shot."}
 _A2_C1P_["Sniper slams a round into the goon&#39;s temple, his head exploding like a piñata."]
 _A3_(["Muscle #2 brushes the brains off his jacket and approaches the mistress."])
 _A3_1_(["As the team closes in, another car screeches to a stop, more heavies pouring out."])
 _A3_C1_{"Weapons drawn, Muscle #1 and Muscle #3 step out to confront the gangsters."}
 _A3_C1F_["The mob boss&#39;s goons gain the upper hand, subduing two members of the crew."]
 _A3_6_(["Amid the tense standoff, the mistress emerges and calls for a ceasefire."])
 _B1_(["She glides elegantly through the chaos, her voice calm as she beckons the team&#39;s leader."])
 _B1_C1_{"Enforcer offers his phone, giving the mistress a chance to speak with their boss."}
 _B1_C1F_["Enforcer&#39;s deception fails and the gangsters step up to defend the mistress."]
 _B1_C2_{"With a bird&#39;s-eye view, Sniper picks out targets. The mistress runs for cover."}
 _B1_C2P_["The sniper downs two guards in quick succession, turning the tide in the team&#39;s favor."]
 _B1_6_(["A shootout breaks out across the street as the crew tries to finish the job."])
 _B2_6_(["Police cars screech onto the scene and an officer orders everyone to cease fire."])
 _B2_C1_{"Showing complete disregard for authority, Muscle #1 starts blasting at the cops."}
 _B2_C1F_["Muscle #1 falls to a gut shot. Enforcer hits back but is taken down too."]
 _B2_7_(["With the team in disarray, the mistress and her guard make a break for the third sedan."])
 _B2_C2_{"Sniper calmly tracks the car as it reverses, focusing his aim on the driver."}
 _B2_C2F_["Sniper&#39;s shot falls short, allowing the mistress to escape."]
 _B2_11_(["Sniper hears boots stomping up the stairway behind him—trouble has arrived."])
 _B2F_(["With most of the team heading to hospital or the jail, the mission is a washout."])
 _A1_C2F_["The guard looks up but Muscle #1 reacts too late, his shots missing the mark."]
 _A1_C3_{"With time wasted, Enforcer and Muscle #3 advance toward the mistress."}
 _A1_C3P_["A goon charges out to confront the threat but Enforcer drops her with ease."]
 _A2_C1F_["Sniper&#39;s shot grazes the gangster&#39;s ear but he&#39;s unfazed by the near miss."]
 _A2_C2_{"The thug&#39;s grip on Muscle #2 tightens, prompting Muscle #1 to open fire."}
 _A2_C2P_["Muscle #1 blasts the goon&#39;s head open, its contents spilling like an underboiled egg."]
 _B1_C2F_["The sniper misses the shot and exposes his position to the enemy."]
 _B1_3_(["Before Sniper can react, a guard drops him with a pistol shot."])
 _B1_4_(["The gangsters pile into the one working sedan just as the cops arrive."])
 _B1_5_(["With the team pinned by the police, the mistress escapes, as does Lookout."])
 _B1F_(["The rest of the crew is forced to give up and they&#39;re taken into custody."])
 _A3_C1P_["Two toughs are downed as Sniper&#39;s gunfire keeps a third pinned behind a vehicle."]
 _A4_(["To stop the bloodshed, the mistress emerges from hiding and calls for a ceasefire."])
 _A4_1_(["She offers to hand over her valuables if anyone can defeat her bodyguard in a fistfight."])
 _A4_2_(["Enforcer accepts the duel, seizing the chance to send a message to the mob boss."])
 _A4_C1_{"Enforcer squares off with the guard, fists flying as they pummel each other."}
 _A4_C1F_["Enforcer is caught off guard by a low blow and is finished by a savage uppercut."]
 _A4_3_(["With the mission falling apart, the team draws their weapons and moves in."])
 _A4_4_(["This prompts the bodyguard to drag the mistress to cover behind a wrecked sedan."])
 _B2_5_(["A shootout ensues, bullets flying in all directions."])
 _B2_C1P_["Muscle #1 ruthlessly guns down the two police officers."]
 _B3_(["As reinforcements arrive, Lookout alerts the team to the escalating situation."])
 _B3_1_(["Lookout orders Sniper to open fire on the second squad car."])
 _B3_C1_{"Exhaling slowly, Sniper trains his sights on the closest of the two officers."}
 _B3_C1F_["Sniper misses, receiving a volley of gunfire in return as he takes cover."]
 _B3_2_(["As more officers flood the scene, the team scatters, allowing the mistress to escape."])
 _B3_3_(["The sniper and lookout sneak off while the others are busted."])
 _B3F_(["With most of the team in custody and the mistress gone, the mission is abandoned."])
 _A4_C1P_["Enforcer dominates the fight, knocking the goon out with a sweet right cross."]
 _A5_(["With the team focused on the brawl, the mistress escapes, fleeing with one of the goons."])
 _A5_1_(["Sniper spots the mistress and adjusts his aim, finger steady on the trigger."])
 _A5_C1_{"Lookout distracts the target with a shout, giving Sniper time to aim."}
 _A5_C1F_["Sniper miscalculates and the bullet tears through the mistress&#39;s arm."]
 _A7_(["The gangster scurries away like a coward, leaving the mistress to an uncertain fate."])
 _A7_1_(["The team moves in and relieves the mistress of her valuables."])
 _A7S_(["As their victim loses consciousness, the team escapes before the authorities show up."])
 _A1_C1P_["Lookout creates a distraction and Muscle #2 headshots the guard."]
 _A5_C1P_["As they cross the street, Sniper drops the gangster with a shot to the chest."]
 _A6_(["The team apprehends the mistress and drags her back to the car."])
 _A6_1_(["Grabbing her valuables, Muscle #1 warns they&#39;ll take a piece of her too next time."])
 _A6S_(["With the message delivered, the team leaves—the mistress surrounded by her dead henchmen."])
 _B1_C1P_["The mistress falls for it, allowing Enforcer to twist her arm into submission."]
 _B2_(["With Enforcer&#39;s gun at her temple, she warns the guards to step back."])
 _B2_1_(["One guard ignores the order and charges headlong at Enforcer."])
 _B2_2_(["Sniper acts quickly, dispatching the guard with a long-distance headshot."])
 _B2_3_(["Startled by the gunfire, Enforcer loses his grip on the mistress."])
 _B2_4_(["A guard sacrifices his life for the mistress, shoving her toward his colleagues."])
 _B3_C1P_["The sniper cuts down the first cop with precision, dropping the second soon after."]
 _B4_(["Shaken by the team&#39;s merciless slaughter of the police officers, the gangsters back down."])
 _B4S_(["The team helps itself to the mistress&#39;s valuables before leaving the scene."])
 _B2_C2P_["The shot pierces the windshield, killing the driver and causing the car to crash."]
 _B2_8_(["Risking their lives, the cops rush across the street to check on the vehicle."])
 _B2_9_(["Muscle #2 and Muscle #3 stalk toward the officers and gun them down."])
 _B2_10_(["They smash their way into the car, discovering the mistress alive but gravely wounded."])
 _B2S_(["With the message sent loud and clear, the team takes what it can before making a getaway."])
 _A2_C2F_["Muscle #1 rushes the shot and misses, forcing the team to retreat."]
 _A2_4_(["With the odds already turning against them, a third sedan arrives on scene."])
 _A2F_(["Vastly outgunned, the crew is forced to back down and allow the mistress to escape."])
 _A1_C3F_["As Muscle #3 steps into the open, another gangster ambushes her."]
 _A1_6_(["Overzealous, the team pushes forward, with Muscle #1 taking a hit to the leg."])
 _A1_7_(["The situation deteriorates further as reinforcements from the mob arrive to take control."])
 _A1_8_(["Enforcer and Muscle #2 surrender but the goons beat them senseless anyway."])
 _A1F_(["When the coast is clear, the others regroup to aid their teammates, the mission a bust."])

