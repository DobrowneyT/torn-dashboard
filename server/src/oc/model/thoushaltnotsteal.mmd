flowchart LR
 _Prelude_(["Distract the pastor and rob as much as you can from the church."])
 _A1_(["Arriving for the funeral service, the crew gathers outside the church."])
 _A1_1_(["Picklock leads the way as they blend into the crowd of mourners."])
 _A1_2_(["Pastor Williams greets everyone at the door, scrutinizing their demeanor intently."])
 _A1_3_(["As they take their seats, Thief spots the collection plate being passed around."])
 _A1_C1_{"Thief tries to steal cash from the plate as it passes."}
 _A1_C1P_["The plate is deliberately tipped by Thief, allowing some cash to fall to the floor."]
 _A2_R1_(["When nobody is looking, Thief scoops up a large wad of notes."])
 _A2_(["Pastor Williams approaches the pulpit and begins his eulogy for the deceased."])
 _A2_1_(["With a heartfelt tribute complete, the grieving crowd gets up to pay their respects."])
 _A2_2_(["Pickpocket pulls out his spare cell phone and approaches the open casket."])
 _A2_C1_{"Pickpocket tries to secrete the cell phone inside the casket."}
 _A2_C1P_["Leaning in to kiss the corpse&#39;s hand, Pickpocket slips the cell phone inside its sleeve."]
 _A3_(["The casket lid is fastened shut and the pastor leads the pallbearers outside."])
 _A3_1_(["Pickpocket calls the hidden phone, halting the procession abruptly."])
 _A3_2_(["Picklock and Thief use the distraction to hide in the confessional booth."])
 _A3_3_(["Pastor Williams finds the phone and the procession continues, Pickpocket following it outside."])
 _A3_4_(["With the coast clear, Thief dons the cassock and leads Picklock to the vestry."])
 _A3_5_(["Thief disperses the lingering choristers as Picklock approaches the door."])
 _A3_C1_{"Picklock tries to pick through the locked door."}
 _A3_C1P_["The lock yields to Picklock, allowing the pair to enter the vestry."]
 _A4_(["Picklock pulls the door shut and stands guard while Thief gets to work."])
 _A4_C1_{"Thief quietly searches the room for valuable loot."}
 _A4_C1F_["After looking high, low, and somewhere in-between, Thief finds nothing worth taking."]
 _A4_C2_{"Thief hunts more aggressively, pulling open cabinets and tossing aside boxes."}
 _A4_C2P_["A chaotic and noisy search ends with Thief finding a tithe box."]
 _A5_R2_(["Thief takes most of the cash from the box, leaving only coins behind."])
 _A5_(["Picklock gets a call from Pickpocket informing her that Pastor Williams is returning!"])
 _A5_C1_{"Picklock tries to jam the lock shut to prevent them from being discovered."}
 _A5_C1P_["Picklock blocks the locking mechanism with her lockpicks, frustrating the pastor."]
 _A6_(["When Pastor Williams makes for the other door, the pair slip out quickly through the side."])
 _A6_1_(["Back at the funeral, Pickpocket sees his teammates leaving."])
 _A6_C1_{"Pickpocket tries to pickpocket some of the mourners while they are distracted."}
 _A6_C1P_["Waiting until the casket is being lowered, Pickpocket starts dipping into people&#39;s pockets."]
 _A7_R1_(["Pickpocket rakes in six figures before deciding enough is enough."])
 _A7_(["The pickpocket backs away from the crowd and sneaks off to rejoin his teammates."])
 _A7S_(["The crew escapes with an unholy haul of stolen cash, the gods the only witnesses to their crimes."])
 _A2_C1F_["A mourner slaps Pickpocket and tells him to show some respect for the dead."]
 _A2_C2_{"Pickpocket tries to pass the phone to Thief to let her take a shot."}
 _A2_C2P_["The phone is passed, and a hysterical sobbing display from Thief masks the drop."]
 _A4_C1P_["The church&#39;s charity donation box is located and busted open."]
 _A5_R1_(["Thief clears out the entire charity fund without a shred of guilt."])
 _A3_C1F_["The lock resists Picklock&#39;s attempt to pick his way in."]
 _A3_6_(["Wary of attracting suspicion, Picklock heads off to find an alternative way in."])
 _A3_7_(["Picklock finds a maintenance closet that might contain a set of keys."])
 _A3_C2_{"Picklock deploys his picks on the maintenance closet lock."}
 _A3_C2P_["A subtle click sees the door submit to Picklock&#39;s skills."]
 _A3_9_(["Picklock searches the pegboard and finds the key to the vestry."])
 _A6_C1F_["Pickpocket&#39;s attempt is noticed, but their intentions are disguised with a sobbing fit."]
 _A6_C2_{"Pickpocket makes another play for the pockets of the grieving."}
 _A6_C2P_["A single mourner is pickpocketed while waiting to toss dirt upon the casket."]
 _A7_R2_(["Emptying their billfold, Pickpocket pockets a five-figure sum."])
 _A7_1_(["Several people start mumbling, so the cutpurse skulks off toward their teammates."])
 _A7S2_(["The team leaves the funeral with a clean getaway but a filthy conscience."])
 _A1_C1F_["His clumsy effort draws attention, and Thief hands the plate to Pickpocket."]
 _A1_C2_{"Pickpocket attempts to palm some cash using a fake donation."}
 _A1_C2P_["Pickpocket puts down a small amount of cash but scoops up far more than he donated."]
 _A2_R2_(["A fistful of cash is taken by Pickpocket and discreetly palmed to Thief."])
 _A1_C2F_["Pickpocket takes exactly as much as he donated, achieving nothing."]
 _A1_C3_{"Picklock grabs the plate and tries to succeed where the others failed."}
 _A1_C3P_["Picklock&#39;s nimble fingers secure a wad of cash with minimal fuss."]
 _A2_R3_(["A small amount of cash is stolen and nimbly passed over to Thief."])
 _A5_C1F_["Picklock&#39;s effort fails and the pastor storms inside with righteous fury."]
 _A5_1_(["The pastor sees Thief&#39;s cassock and softens, but still demands an explanation."])
 _A5_C2_{"Thief attempts to placate the pastor while Picklock creeps behind."}
 _A5_C2F_["The pastor sees Picklock coming and shoves him to the ground."]
 _A5_2_(["Grabbing a crucifix from his desk, the pastor looms toward Thief menacingly."])
 _A5_C3_{"Thief tries to fight off Pastor Williams with anything he can find."}
 _A5_C3P_["Using a metal Quran stand, Thief blocks the pastor&#39;s attacks."]
 _A5_4_(["The vestry door is blocked with a chair and the pair run out, alerting the choristers."])
 _A5_5_(["Hearing the commotion, Pickpocket realizes it&#39;s time for him to leave."])
 _A5_C4_{"Pickpocket tries to cause a distraction to mask his escape."}
 _A5_C4P_["Pickpocket unclips a casket strap, causing it to tip the body out into the grave."]
 _A5_8_(["The crowd rushes to rectify the situation, allowing Pickpocket to sprint to the vehicle."])
 _A5_9_(["The trio dole out a thrashing to the choirboys, losing some cash in the scuffle."])
 _A5S_(["The team leaves before the cops arrive, having already desecrated this solemn occasion."])
 _A3_C2F_["Picklock&#39;s efforts are resisted as the door refuses to give up its secrets."]
 _A3_8_(["Abandoning the vestry, the pair stalk the other rooms for stealable items."])
 _B3_C1_{"Thief dips into the alms room and starts searching while Picklock keeps watch."}
 _B3_C1P_["Thief finds a donation box for the poor, but it&#39;s locked."]
 _B4_C1_{"Picklock tries to pick open the locked box."}
 _B4_C1P_["The lock clicks open with a twist and a turn from Picklock&#39;s fingers."]
 _B4_R1_(["Several wrapped wads of cash are pilfered from the poor box."])
 _B5_(["Overhearing their antics, several choirboys wander in and start questioning the team."])
 _B5_1_(["When they see Picklock looting the poor box, a scuffle breaks out."])
 _B5_2_(["The choirboys are shoved out of the room and the door is barricaded."])
 _B5_C1_{"Picklock holds the door while Thief hunts for a way out."}
 _B5_C1P_["Thief finds a catch that opens the window, allowing the pair to escape."]
 _B6_(["Back at the funeral, people line up to console the grieving widow."])
 _B6_1_(["Pickpocket notices she&#39;s sporting a rather expensive handbag."])
 _B6_C1_{"Pickpocket tries to dip into the woman&#39;s purse while comforting her."}
 _B6_C1P_["A deft move sees Pickpocket lift a clutch purse from the widow&#39;s coat pocket."]
 _B7_R1_(["The purse is emptied and returned, a large wad of cash added to the team&#39;s collection."])
 _B7S_(["As the funeral concludes, the crew regroups by the entrance, their blasphemy paying dividends."])
 _A5_C2P_["Picklock grabs the Book of Mormon and bashes Pastor Williams over the head, knocking him out."]
 _A5_3_(["The pair leave the vestry in a hurry, alerting the choristers in their haste."])
 _A5_C4F_["Pickpocket tries to interfere with the casket but slips and falls into the grave."]
 _A5_6_(["The mourners notice the others and give chase to help the choirboys."])
 _A5_7_(["Picklock and Thief are set upon by the angry crowd and almost kicked to death."])
 _A5F2_(["Pickpocket writhes around the grave in agony, the crew&#39;s mission damned from the start."])
 _A2_C2F_["Thief gets too close to the corpse and is scolded by a verger."]
 _A2_3_(["Several mourners drag Thief away and frog-march him outside."])
 _A2_4_(["The cops are called, leaving Picklock and Pickpocket no choice but to call off the robbery."])
 _A2F_(["Thief is arrested soon after and is charged with molesting a corpse."])
 _B3_C1F_["Picklock fails to see the choirboys approach and Thief is caught stealing."]
 _B3_1_(["The pair are barricaded in as the choirboys call for help."])
 _B3_2_(["With every exit locked or blocked, Picklock and Thief are forced to accept their fate."])
 _B3F_(["The cops are called and the pair are arrested as Pickpocket saunters off quietly."])
 _A4_C2F_["Despite wrecking the place, Thief still can&#39;t find anything decent."]
 _A4_1_(["The duo gives up on the vestry and heads for the alms room instead."])
 _A4_2_(["Fixed to the wall, Thief immediately spots a poor box loaded with cash."])
 _B4_C1F_["The lock is too old and robust for Picklock to bypass with his picks."]
 _B4_C2_{"Thief hunts for a key while Picklock keeps trying."}
 _B4_C2P_["Thief finds a key just as Picklock pops the lock, much to their amusement."]
 _B5_C1F_["Thief tries every window and door, but none of them will budge."]
 _B5_C2_{"Thief holds the door as Picklock tries to unlock the entrance opposite."}
 _B5_C2P_["The door yields to Picklock&#39;s picks and the pair flee across the chancel toward the exit."]
 _A6_C2F_["A furious woman spins around and cracks Pickpocket in the head with her handbag."]
 _A6_2_(["Realizing what&#39;s happening, the crowd turns on Pickpocket, breaking both of her legs."])
 _A6_3_(["Picklock and Thief see the melee from a distance and wisely choose to leave."])
 _A6S_(["Pickpocket suffers severe injuries, but the others are blessed with good health and riches."])
 _B5_C2F_["Picklock takes too long, and there is trouble waiting when the door is finally unlocked."]
 _B5_3_(["Outmanned and outmaneuvered, the pair are apprehended by the church staff."])
 _B5F_(["When the cops show up soon after, Pickpocket realizes it&#39;s time to haul ass."])
 _B4_C2F_["With the lock stuck and no key to be found, Thief tries to bash the box open."]
 _B4_1_(["The noise alerts the choirboys, who sneak off to inform the pastor."])
 _B4_2_(["Aided by funeral-goers and choristers, the pastor corners the thieves in the sacristy."])
 _B4F_(["Pickpocket is the only one to escape justice, although he shall be judged in the afterlife."])
 _B6_C1F_["An old gentleman sees Pickpocket&#39;s wandering hands and stabs him with a flick knife."]
 _B7_1_(["The furious widow removes her shoe and punctures Pickpocket&#39;s eyeball with the heel."])
 _B7_2_(["As the mourners take turns attacking Pickpocket, the others head for the car."])
 _B7S2_(["Pickpocket is left writhing in agony as his crewmates take off with a small fortune."])
 _A5_C3F_["Pastor Williams plunges the crucifix into Thief&#39;s neck, puncturing his artery."]
 _A5_10_(["Picklock tries to run, but the pastor strangles her with a set of mala beads."])
 _A5F_(["When the pastor emerges covered in blood, Pickpocket senses it would be wise to leave."])
