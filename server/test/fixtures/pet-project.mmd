flowchart LR
 _Prelude_(["Kidnap the two expensive dogs from their home and make sure they don&#39;t get injured."])
 _A0_(["Kidnapper hops the fence, hides behind a tree, and waits for the owners to leave."])
 _A0_1_(["The owners drive away from the house. They&#39;re usually not back for several hours."])
 _A0_2_(["Before the gate closes, Kidnapper rushes over and wedges it open using a rock."])
 _A1_(["The crew drives inside and parks by the house."])
 _A1_1_(["Kidnapper peers through the window as Muscle keeps a lookout."])
 _A1_2_(["Picklock finds the circuit breaker and cuts the electricity supply."])
 _A1_C1_{"With the alarm out of action, Picklock tries to pick the front door lock."}
 _A1_C1F_["The attempt proves unsuccessful—this lock is more complex than it looks."]
 _A1_3_(["Noticing the presence of intruders, the dogs start barking frantically."])
 _A1_C2_{"Muscle pushes forward and tries to kick the door through."}
 _A1_C2F_["The door absorbs the impact. Muscle rubs his knee in pain."]
 _A1_C3_{"Picklock has another attempt at picking the lock."}
 _A1_C3P_["Picklock unlocks the door but holds it shut to keep the dogs inside."]
 _A2_(["Picklock opens the door slowly to avoid spooking the dogs."])
 _A2_1_(["The Mastiff barks loudly while the Shih Tzu cowers behind it."])
 _A2_C1_{"Kidnapper pulls out some Dog Treats and tosses it toward the Mastiff."}
 _A2_C1F_["The Mastiff ignores the treat and continues to growl. The dog is clearly agitated."]
 _A2_C2_{"Kidnapper tells the crew to crouch down to seem less of a threat."}
 _A2_C2P_["The dogs start to relax. The Mastiff walks to the treat, sniffs it, and gobbles it up."]
 _A3_(["Its barks quietened, the Mastiff sits expectantly, awaiting another treat."])
 _A3_C1_{"Kidnapper presents another snack and retreats, hoping to lure the dogs."}
 _A3_C1P_["The Mastiff takes the bait but the Shih Tzu retreats back into the house."]
 _A4_(["Muscle walks inside while Picklock blocks the entrance."])
 _A4_Cont1_(["Making encouraging noises, Muscle tries to beckon the Shih Tzu out of hiding."])
 _A4_Cont2_(["Muscle shakes a bag of treats and the Shih Tzu emerges."])
 _A4_C1_{"With treats as bait, Muscle captures the Shih Tzu in his net."}
 _A4_C1P_["Pulling the drawstring on the net, he heads outside to place the dog in the van."]
 _A5_(["Seeing its friend captured and struggling, the Mastiff starts barking furiously."])
 _A5_1_(["Kidnapper diverts its attention by shaking the bag of dog treats."])
 _A5_C1_{"Kidnapper tosses several treats into the back of the van."}
 _A5_C1F_["The dog hesitates and backs away, its gaze fixed upon Kidnapper."]
 _A5_C2_{"Muscle swings a Net over the Mastiff while it&#39;s distracted."}
 _A5_C2P_["With the dog subdued, Muscle hoists it into the back of the van."]
 _A6_(["Muscle goes to close the van door but the Shih Tzu leaps out."])
 _A6_C1_{"Muscle pursues the Shih Tzu, creeping up slowly to avoid spooking it."}
 _A6_C1P_["Muscle grabs the Shih Tzu&#39;s tail and it yelps as it is scooped up."]
 _A7_(["Picklock takes the Shih Tzu and places it in the van, closing the door."])
 _A7_1_(["With both dogs secure, the crew climbs into the van and prepares to leave."])
 _A7_2_(["As the vehicle heads toward the exit, the rock holding the gate becomes dislodged."])
 _A7_C1_{"Picklock races to the gate in a desperate attempt to stop it closing."}
 _A7_C1F_["The gate slams shut, preventing the team from escaping."]
 _A7_C2_{"Muscle becomes impatient and tries to ram the gate with the van."}
 _A7_C2P_["The van hurtles toward the closed gate, crashing through with a deafening crunch."]
 _A7S2_(["The team makes a swift exit with two healthy dogs and a slightly battered van."])
 _A2_C1P_["The dog sniffs the treat tentatively before gobbling it up in one bite."]
 _A3_C1F_["The dogs remain in the doorway, still wary of what these strangers are offering."]
 _A3_C2_{"Muscle makes some exciting noises to lure the dogs out for playtime."}
 _A3_C2P_["The Mastiff walks into the open but the Shih Tzu retreats back into the house."]
 _A5_C1P_["The hungry Mastiff follows the treat trail and leaps into the vehicle."]
 _A6_C1F_["The Shih Tzu bites Muscle&#39;s face and he drops the dog in panic."]
 _A6_1_(["The Shih Tzu sprints under the van and hides."])
 _A6_C2_{"Picklock tries to coax the dog from beneath the vehicle."}
 _A6_C2P_["Picklock earns the dog&#39;s trust and he is able to retrieve it."]
 _A7_C1P_["Picklock holds the gate open and the van pulls out just in time."]
 _A7S1_(["Picklock returns and the team escapes with its canine cargo intact."])
 _A5_C2F_["The Mastiff wriggles free of the net and shoots off into the house."]
 _A5_3_(["The team chases the Mastiff, leaving the van open for the Shih Tzu to escape."])
 _C1_(["The dog waits by the billiard table, its animated demeanor suggesting it&#39;s playing a game."])
 _C1_C1_{"Kidnapper and Picklock try to corner the dog."}
 _C1_C1F_["Giddy with excitement, the Mastiff squirms under the billiard table and evades capture."]
 _C1_2_(["Muscle tries to intercept the dog but it retreats back under the table."])
 _C1_3_(["Through the front window, Muscle notices a cop car parking up outside."])
 _C1F_(["The team takes cover, waiting for the police to leave before escaping empty-handed."])
 _A1_C1P_["Picklock unlocks the door, holding it shut as the dogs approach."]
 _A6_C2F_["The Shih Tzu refuses to come out, despite Picklock&#39;s high-pitched pleas."]
 _A6_C3_{"Muscle impatiently tries to scare the dog out by bashing the van."}
 _A6_C3F_["The frightened Shih Tzu leaps out and bites Muscle&#39;s hand."]
 _A6_2_(["Muscle cries out in agony and lets the Shih Tzu slip away."])
 _A6_3_(["Shocked at Muscle&#39;s disfiguring injury, the crew allows the Mastiff to escape."])
 _A6F_(["With Muscle losing blood, the crew reluctantly abandons the job."])
 _A3_C2F_["The Shih Tzu gets overexcited and runs off while the Mastiff remains in the doorway."]
 _A3_3_(["As Muscle approaches, the Mastiff gets scared and runs inside."])
 _A3_4_(["The team follows the Mastiff into the house, abandoning the Shih Tzu to its adventures."])
 _A1_C2P_["The door gives way with an almighty crack, leaving both dogs visibly frightened."]
 _A1_4_(["The Mastiff runs up the stairs, with the Shih Tzu scampering behind."])
 _B1_(["The crew tries to track the errant hounds while Picklock keeps watch."])
 _B1_1_(["The Mastiff sits patiently by the pool, while the trembling Shih Tzu hovers nearby."])
 _B1_C1_{"Muscle pulls out some Dog Treats and beckons the Mastiff over."}
 _B1_C1P_["The Mastiff ambles calmly toward Muscle, who grabs its collar tight."]
 _B2_(["Kidnapper chases the Shih Tzu around the pool room, unable to catch the little tyke."])
 _B2_Cont_(["The Shih Tzu slips on the wet floor and bangs its head before falling into the pool."])
 _B2_C1_{"Kidnapper attempts to retrieve the lifeless little dog before it drowns."}
 _B2_C1P_["Kidnapper retrieves the Shih Tzu. It vomits up water and starts yelping."]
 _B3_(["Kidnapper carries the exhausted Shih Tzu outside."])
 _B3_1_(["The Mastiff gets excited and follows Muscle out of the house."])
 _B3_2_(["Picklock throws a stick to distract the Mastiff."])
 _B3_3_(["Kidnapper places the weary Shih Tzu in the back of the van."])
 _B3_4_(["With one dog secured, Kidnapper uses treats to lure the Mastiff."])
 _B3_5_(["The Mastiff thinks it&#39;s playtime and runs off with the stick."])
 _B3_6_(["Unwilling to give chase, the team decides to make do with the Shih Tzu."])
 _B3S_(["The crew piles into the van and escapes the house with one slightly concussed little dog."])
 _A4_C1F_["Muscle&#39;s loose grip on the net allows the Shih Tzu to wriggle free."]
 _A4_1_(["The Shih Tzu scrambles over the fence and disappears into the bushes."])
 _A4_2_(["As the team focuses on the Shih Tzu, the Mastiff slips back into the house."])
 _C1_C1P_["The Mastiff rolls playfully onto its back, exposing its belly."]
 _C2_(["Kidnapper and Picklock haul the dog outside, taking one end each."])
 _C2_1_(["As the team exits the property, Muscle spots a cop car rolling by."])
 _C3_(["The team quickly puts the Mastiff in the van and prepares to leave without the Shih Tzu."])
 _C3S_(["With the area clear of cops, the team is free to leave with just one dog in tow."])
 _B2_C1F_["The dog is pulled from the water, but it isn&#39;t breathing, and CPR proves fruitless."]
 _B2_1_(["Cradling the dog&#39;s lifeless corpse, Kidnapper begins to sob."])
 _B2_2_(["The Mastiff gets angry at the sight of its dead friend and breaks free."])
 _B2_3_(["A whirlwind of snarls and fury, the Mastiff is too enraged to be controlled."])
 _B2F_(["The team cuts its losses and departs, leaving the Mastiff to mourn its companion."])
 _A2_C2F_["The dogs are calmed but Muscle moves too soon and spooks them again."]
 _A2_2_(["The Mastiff runs up the stairs and into the house, with the Shih Tzu scampering behind."])
 _B1_C1F_["The Mastiff pulls back. It remains highly suspicious and on edge."]
 _B1_C2_{"Muscle attempts to subdue the Mastiff with a headlock."}
 _B1_C2P_["The dog calms down, allowing Muscle to wrestle it under control."]
 _A6_C3P_["The Shih Tzu bolts and Muscle dives to stop it with his body."]
 _A8_(["The Shih Tzu is struggling for air—it must have been injured in the melee."])
 _A8_1_(["With the dog unlikely to survive, Muscle snaps its neck."])
 _A8S_(["The team returns to the van and leaves the scene with one dog and a guilty conscience."])
 _A7_C2F_["The van slams into the closed gate but it holds strong."]
 _A7_3_(["The van’s doors burst open on impact and the Mastiff escapes onto the driveway."])
 _A7_4_(["As the crew tries to catch the dog, the homeowners return unexpectedly."])
 _A7_5_(["Recognizing the danger, everyone rushes back to the vehicle."])
 _A7_6_(["Muscle revs the engine but the homeowners refuse to back out."])
 _A7_7_(["Picklock grabs the Shih Tzu and hurls it toward the car&#39;s windshield."])
 _A7F_(["With the homeowners distracted, the team crashes through the fence to escape."])
 _B1_C2F_["The Mastiff breaks free and sinks its teeth into Muscle&#39;s leg."]
 _B1_2_(["Kidnapper tries to break up the fight but stumbles, falling into the pool."])
 _B1_3_(["Kidnapper is pulled from the pool, blood streaming from a head wound."])
 _B1_4_(["Kidnapper has a pulse but isn&#39;t breathing."])
 _B1_5_(["Muscle abandons Kidnapper and flees the building."])
 _B1F_(["The team scrambles into the van, leaving the dogs and Kidnapper behind."])
 _A1_C3F_["Picklock uses too much force, causing the pick to snap in the lock."]
 _A1_5_(["Kidnapper searches the rear of the house for an alternative way inside."])
 _A1_6_(["Looking through the glass, he sees a secondary alarm system has been activated!"])
 _A1_7_(["Kidnapper rushes back to inform the crew of this development."])
 _A1F_(["Unwilling to take the risk, the crew decides to abandon the job."])

