# Copy to deploy/.env and fill in before `docker compose up`.
POSTGRES_USER=postgres
POSTGRES_PASSWORD=change-me
# Signs API session JWTs — generate a real one with: openssl rand -hex 32
JWT_SECRET=change-me-too
# Faction-held Limited Access Torn key for server-side live reads (OC board).
# Optional — live-crimes endpoints return 503 until set. Superseded by the
# consented key pool in migration slice #67.
TORN_API_KEY=
# Host port nginx listens on (http://localhost:8088)
HTTP_PORT=8088
# Host port Postgres is published on (127.0.0.1 only)
POSTGRES_HOST_PORT=5432
