# Copy to deploy/.env and fill in before `docker compose up`.
POSTGRES_USER=postgres
POSTGRES_PASSWORD=change-me
# Signs API session JWTs — generate a real one with: openssl rand -hex 32
JWT_SECRET=change-me-too
# Host port nginx listens on (http://localhost:8088)
HTTP_PORT=8088
# Interface to publish it on. Leave 0.0.0.0 for local dev. Set to 127.0.0.1 when
# a host reverse proxy fronts the stack (the Hetzner deployment) so the stack is
# reachable only through that proxy, never straight off the internet.
HTTP_BIND=0.0.0.0
# Host port Postgres is published on (127.0.0.1 only)
POSTGRES_HOST_PORT=5432

# In-process scrapers (slice #67+). Generate the key with:
#   openssl rand -hex 32
KEY_ENCRYPTION_KEY=

# War-room spy-stat providers (optional; Update Spies answers 503 without them)
TORNSTATS_API_KEY=
BSP_API_KEY=

# War Room push notifications (#207, optional). Generate the keypair once with:
#   npx web-push generate-vapid-keys
# then paste both keys here. One keypair is shared by all faction API processes
# (it identifies this push server, not a faction). Push stays off until set.
# See docs/PUSH.md.
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
# Contact URI required by the VAPID spec (mailto: or https://).
VAPID_SUBJECT=mailto:admin@example.com

# In-app feedback → GitHub issue (#253, optional). A fine-grained PAT with
# issues:write on the feedback repo; kept server-side, never sent to the browser.
# The "Send feedback" nav entry and POST /api/feedback stay off until the token
# is set. Wire these into each tenant's API service env (override.yml), like the
# spy/VAPID vars above.
FEEDBACK_GITHUB_TOKEN=
# Target repo "owner/name" (defaults to DobrowneyT/torn-dashboard).
FEEDBACK_GITHUB_REPO=DobrowneyT/torn-dashboard
# Triage label applied to every feedback issue (defaults to needs-triage).
FEEDBACK_LABEL=needs-triage
# Base domain used to build each tenant's PUBLIC_BASE_URL (https://<slug>.<domain>)
# in the generated api-<slug> service. Feedback attachment URLs embed it so
# GitHub can fetch the images/video. Defaults to monchoon.me; set it if the
# stack is served from a different domain.
PUBLIC_DOMAIN=monchoon.me

# Off-site backups (#117, optional). Until RCLONE_REMOTE is set the backup
# sidecar keeps local dumps only. rclone reads its remote config straight from
# these env vars — no config file. See deploy/LAUNCH.md Phase 8.
RCLONE_REMOTE=
RCLONE_CONFIG_B2_TYPE=b2
RCLONE_CONFIG_B2_ACCOUNT=
RCLONE_CONFIG_B2_KEY=

# ── Admin control plane (#609, optional) ─────────────────────────────────────
# The admin container sits behind `profiles: ["admin"]`, so none of this is
# needed to run the fleet. Credentials are generated, never hand-written:
#   npx tsx db/admin-password.mts
# which prints ADMIN_USERNAME / ADMIN_PASSWORD_HASH / ADMIN_TOTP_SECRET /
# ADMIN_SESSION_SECRET ready to paste. The service REFUSES TO START if any of
# them is missing — an admin surface that comes up with no gate is worse than
# one that does not come up.
ADMIN_USERNAME=
ADMIN_PASSWORD_HASH=
ADMIN_TOTP_SECRET=
ADMIN_SESSION_SECRET=

# Alerting (#609 slice 4). Every line below is optional; unset means the status
# page is the only place alerts appear.
#
# ⚠️ A literal `$` in any value must be doubled (`$$`) — compose interpolates
# inside .env values and truncates silently. This is what crash-looped the admin
# container on its first deploy.
#
# Urgent only: tenant down, backup stale, disk critical, prices stale. Point it
# at an ADMIN-ONLY Discord channel — a webhook, not a bot, so it cannot read.
ADMIN_DISCORD_WEBHOOK_URL=
# Daily digest of everything else. One URL, e.g.
#   smtps://user:app-password@smtp.gmail.com:465
ADMIN_SMTP_URL=
ADMIN_DIGEST_TO=
ADMIN_DIGEST_FROM=
# Hour (UTC) the digest goes out. It is sent EVERY day, including quiet ones —
# a digest that only arrives when something is wrong makes silence ambiguous.
ADMIN_DIGEST_HOUR_UTC=8
# Poll period. Two cycles must pass before an incident is announced, so this
# also sets how long a blip has to persist before it wakes anyone.
ADMIN_ALERT_INTERVAL_MS=60000
# Linked from the digest; also labels the webhook if more than one fleet exists.
ADMIN_PUBLIC_URL=
ADMIN_HOST_LABEL=

# The item catalogue for the whole fleet (#609 slice 7, optional). MonChoon's
# own Torn key — /v2/torn/items is public, so one key serves every faction and
# saves four API calls a cycle.
#
# ⚠️ Unset means the control plane publishes no prices and every tenant syncs
# from its own key pool exactly as before. That is a supported state: the
# fallback is what makes centralising safe, because one key feeding the whole
# fleet fails SILENTLY (see #123/#124).
ADMIN_TORN_API_KEY=

# Fleet metrics (#632, optional). Lets the control plane see key-pool depth and
# failing scrapers — the two numbers that would have caught #645 on day one
# instead of day thirteen.
#
#   openssl rand -hex 32
#
# ⚠️ Set it ONCE here. The admin container derives each tenant's token as
# HMAC-SHA256(secret, slug), and every api-<slug> service is given only its own
# derived value — so a leak from one faction's environment cannot read another's.
# Unset means the endpoint is not registered at all and the alerts stay silent,
# which reads as "not measured", never as "all fine".
#
# ⚠️ Setting this is only HALF the job on a fleet that already exists.
# new-faction.mjs bakes the token in at provisioning time, so only factions
# created AFTER this line is filled get one. Backfill the rest — and re-run it
# after any rotation, since rotating changes every token at once:
#
#   node db/fleet-metrics-token.mjs --write
#   docker compose ... up -d --no-deps api-<slug>...   # then the admin service
#
# A tenant left on a stale token 401s and shows as "not measured" on the status
# page, which is exactly the shape #645 hid in for thirteen days.
#
# ⚠️ The SAME secret also backs the Chain Watch token the Discord bot holds
# (#782) — scoped separately as HMAC(secret, "chain-watch:" + slug), so the bot
# does not gain fleet metrics by being given sign-up times. It has its own
# writer, and a rotation has to run both:
#
#   node db/chain-watch-token.mjs --write
#
# See docs/runbooks/chain-watch-discord.md.
FLEET_METRICS_SECRET=

# The public domain tenants are served on, e.g. `monchoon.me`, so the tenant
# registry can report each faction's URL as `https://<slug>.<domain>`.
#
# ⚠️ A bare domain — no scheme, no trailing path. `https://example.com/` would
# compose into `https://forge.https://example.com/`, which is wrong rather than
# obviously broken; the registry rejects it and reports no URLs instead.
#
# Unset is supported: the registry lists the slugs with a null base_url and says
# why. The Discord bot then refuses `/choon faction add` with a message naming
# this variable, rather than writing a tenant pointed at a hostname nobody
# checked.
TENANT_BASE_DOMAIN=

# ── Chain Watch staging (#782, #785) ─────────────────────────────────────────
# Only used by the staging instance (deploy/dev-deploy.sh); production tenants
# take CHAIN_WATCH_TOKEN from docker-compose.override.yml instead.
#
# ⚠️ These live HERE rather than being passed on the command line. deploy/.env.dev
# is regenerated on every deploy, so a value passed once is wiped by the next
# --if-changed cron run and the endpoint silently returns to 404.
#
#   DEV_CHAIN_WATCH_TOKEN=$(openssl rand -hex 32)
# ⚠️ A value of its own, never a live tenant's token: both read the same
# faction's data, but a token that only opens the copy cannot be used on prod.
DEV_CHAIN_WATCH_TOKEN=

# Directory the Discord bot listens in for board-redraw nudges. Must be owned by
# the bot's user — /run is root-owned and is a tmpfs cleared on reboot.
DEV_CHAIN_NOTIFY_DIR=
