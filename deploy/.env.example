# Copy to deploy/.env and fill in before `docker compose up`.
POSTGRES_USER=postgres
POSTGRES_PASSWORD=change-me
# Signs API session JWTs — generate a real one with: openssl rand -hex 32
JWT_SECRET=change-me-too
# Host port nginx listens on (http://localhost:8088)
HTTP_PORT=8088
# Interface to publish it on. Leave 0.0.0.0 for local dev. Set to 127.0.0.1 when
# a host reverse proxy fronts the stack (the Hetzner deployment) so the stack is
# reachable only through that proxy, never straight off the internet.
HTTP_BIND=0.0.0.0
# Host port Postgres is published on (127.0.0.1 only)
POSTGRES_HOST_PORT=5432

# In-process scrapers (slice #67+). Generate the key with:
#   openssl rand -hex 32
KEY_ENCRYPTION_KEY=

# War-room spy-stat providers (optional; Update Spies answers 503 without them)
TORNSTATS_API_KEY=
BSP_API_KEY=

# War Room push notifications (#207, optional). Generate the keypair once with:
#   npx web-push generate-vapid-keys
# then paste both keys here. One keypair is shared by all faction API processes
# (it identifies this push server, not a faction). Push stays off until set.
# See docs/PUSH.md.
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
# Contact URI required by the VAPID spec (mailto: or https://).
VAPID_SUBJECT=mailto:admin@example.com

# In-app feedback → GitHub issue (#253, optional). A fine-grained PAT with
# issues:write on the feedback repo; kept server-side, never sent to the browser.
# The "Send feedback" nav entry and POST /api/feedback stay off until the token
# is set. Wire these into each tenant's API service env (override.yml), like the
# spy/VAPID vars above.
FEEDBACK_GITHUB_TOKEN=
# Target repo "owner/name" (defaults to DobrowneyT/torn-forge-oc-system).
FEEDBACK_GITHUB_REPO=DobrowneyT/torn-forge-oc-system
# Triage label applied to every feedback issue (defaults to needs-triage).
FEEDBACK_LABEL=needs-triage
# Public origin of this tenant (e.g. https://forge.example.com). Feedback
# attachment URLs embed it so GitHub can fetch the images/video. Falls back to
# the request host when unset — set it when a TLS-terminating proxy fronts the
# stack so the embedded links use https and the public hostname.
PUBLIC_BASE_URL=

# Off-site backups (#117, optional). Until RCLONE_REMOTE is set the backup
# sidecar keeps local dumps only. rclone reads its remote config straight from
# these env vars — no config file. See deploy/LAUNCH.md Phase 8.
RCLONE_REMOTE=
RCLONE_CONFIG_B2_TYPE=b2
RCLONE_CONFIG_B2_ACCOUNT=
RCLONE_CONFIG_B2_KEY=
